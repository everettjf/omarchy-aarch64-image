# Arch Linux ARM publishes the generic rootfs as a rolling "latest" artifact.
# The builder records the verified digest in the output provenance file.
ROOTFS_URL=http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz
ROOTFS_SIGNING_FINGERPRINT=68B3537F39A313B3E574D06777193F152BDBE6A6
ARCHLINUXARM_KEYRING_URL=https://raw.githubusercontent.com/archlinuxarm/archlinuxarm-keyring/master/archlinuxarm.gpg

# Omarchy is a separate source project. Normal builds fetch this exact commit;
# --omarchy-source exists only for explicit local development overrides.
OMARCHY_AARCH64_URL=https://github.com/riverscn/omarchy-aarch64.git
OMARCHY_AARCH64_REF=f38d909b38e4fc34d1853daf11039e2fbb96ead7
OMARCHY_AARCH64_VERSION=4.0.2
OMARCHY_AARCH64_PACKAGE_VERSION=4.0.2-4

# The latest stable GitHub Release is a complete signed pacman repository.
# Image builds verify its manifest and bootstrap key against this pinned
# fingerprint. The same URL remains configured in the guest for normal updates.
OMARCHY_AARCH64_REPOSITORY_URL=https://github.com/riverscn/omarchy-pkgs-aarch64/releases/latest/download
OMARCHY_AARCH64_SIGNING_FINGERPRINT=2A388EDA14046A9218EA5B39D34CA866CE325F2D

# The package repository also owns the native Arch Linux ARM builder image.
# Release workflows build that environment from a reviewed, immutable commit;
# package installation still follows the independently verified latest Release.
OMARCHY_PKGS_AARCH64_URL=https://github.com/riverscn/omarchy-pkgs-aarch64.git
OMARCHY_PKGS_AARCH64_REF=cd2b41bec8a8a49be4a9a6328d2db9c7c73f43cc

# Guest input and authenticated host integration are supplied by EZVM's static
# Linux agent. The authenticated Agent session channel is authoritative for
# clipboard integration; SPICE remains a compatibility fallback.
EZVM_GUEST_AGENT_URL=https://github.com/everettjf/ezvm.git
EZVM_GUEST_AGENT_REF=331bfb4fed6233b046d13530242c829840b254b3

# wl-clipboard 2.3.0 regressed stdin-backed ownership in the Omarchy Wayland
# session. EZVM streams both text and binary clipboard payloads, so build the
# safe Rust implementation at an immutable revision and install its compatible
# wl-copy frontend ahead of /usr/bin.
WL_CLIPBOARD_RS_URL=https://github.com/YaLTeR/wl-clipboard-rs.git
WL_CLIPBOARD_RS_REF=2f6a8852665bd1891a3f3ffa204e62b0f588ef95

# The exact archive and checksum selected from this directory are recorded.
NODE_DIST_URL=https://nodejs.org/dist/latest
