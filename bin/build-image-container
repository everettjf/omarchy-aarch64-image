#!/bin/bash

set -euo pipefail

PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly PROJECT_ROOT
readonly BUILDER_IMAGE=${OMARCHY_AARCH64_BUILDER_IMAGE:-omarchy-pkg-builder:latest-aarch64-edge}

SOURCE_MOUNT=""
REPOSITORY_MOUNT=""
AGENT_MOUNT=""
CONTAINER_ARGS=()

fail() {
  printf '\033[31mError:\033[0m %s\n' "$*" >&2
  exit 1
}

resolve_existing_path() {
  local path=$1 resolved
  [[ -e $path ]] || return 1
  resolved=$(realpath -- "$path" 2>/dev/null) ||
    resolved=$(realpath "$path" 2>/dev/null) || return 1
  printf '%s\n' "$resolved"
}

command -v docker >/dev/null 2>&1 || fail "missing required command: docker"
command -v realpath >/dev/null 2>&1 || fail "missing required command: realpath"
[[ $(uname -m) == aarch64 || $(uname -m) == arm64 ]] ||
  fail "container image assembly currently requires a native AArch64 host"
docker info >/dev/null 2>&1 || fail "Docker is unavailable or its daemon is not running"
docker image inspect "$BUILDER_IMAGE" >/dev/null 2>&1 ||
  fail "builder image not found: $BUILDER_IMAGE (build the AArch64 builder from omarchy-pkgs-aarch64/build first)"

while (($#)); do
  case $1 in
    --omarchy-source)
      (($# >= 2)) || fail "--omarchy-source requires a path"
      [[ -z $SOURCE_MOUNT ]] || fail "--omarchy-source may only be specified once"
      SOURCE_MOUNT=$(resolve_existing_path "$2") || fail "Omarchy source not found: $2"
      CONTAINER_ARGS+=(--omarchy-source /omarchy-source)
      shift 2
      ;;
    --omarchy-repository)
      (($# >= 2)) || fail "--omarchy-repository requires a path"
      [[ -z $REPOSITORY_MOUNT ]] || fail "--omarchy-repository may only be specified once"
      REPOSITORY_MOUNT=$(resolve_existing_path "$2") || fail "Omarchy repository not found: $2"
      [[ -d $REPOSITORY_MOUNT ]] || fail "Omarchy repository is not a directory: $2"
      CONTAINER_ARGS+=(--omarchy-repository /omarchy-repository)
      shift 2
      ;;
    --ezvm-guest-agent)
      (($# >= 2)) || fail "--ezvm-guest-agent requires a path"
      [[ -z $AGENT_MOUNT ]] || fail "--ezvm-guest-agent may only be specified once"
      AGENT_MOUNT=$(resolve_existing_path "$2") || fail "EZVM guest agent not found: $2"
      [[ -f $AGENT_MOUNT ]] || fail "EZVM guest agent is not a file: $2"
      CONTAINER_ARGS+=(--ezvm-guest-agent /ezvm-agent)
      shift 2
      ;;
    *)
      CONTAINER_ARGS+=("$1")
      shift
      ;;
  esac
done

DOCKER_ARGS=(
  run --rm --privileged --user root
  --mount "type=bind,source=$PROJECT_ROOT,target=/project"
)
if [[ -n $SOURCE_MOUNT ]]; then
  DOCKER_ARGS+=(--mount "type=bind,source=$SOURCE_MOUNT,target=/omarchy-source,readonly")
fi
if [[ -n $REPOSITORY_MOUNT ]]; then
  DOCKER_ARGS+=(--mount "type=bind,source=$REPOSITORY_MOUNT,target=/omarchy-repository,readonly")
fi
if [[ -n $AGENT_MOUNT ]]; then
  DOCKER_ARGS+=(--mount "type=bind,source=$AGENT_MOUNT,target=/ezvm-agent,readonly")
fi

exec docker "${DOCKER_ARGS[@]}" \
  --workdir /project \
  --env "HOST_UID=$(id -u)" \
  --env "HOST_GID=$(id -g)" \
  --env "OMARCHY_IMAGE_LOW_DISK=${OMARCHY_IMAGE_LOW_DISK:-0}" \
  "$BUILDER_IMAGE" \
  bash -lc '
    set -euo pipefail
    restore_ownership() {
      chown -R "$HOST_UID:$HOST_GID" /project/build
    }
    trap restore_ownership EXIT
    pacman -Syu --needed --noconfirm btrfs-progs dosfstools parted
    /project/bin/build-image "$@"
  ' build-image "${CONTAINER_ARGS[@]}"
