#!/bin/bash

set -euo pipefail

PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
IMAGE_PATH="$PROJECT_ROOT/build/omarchy-aarch64-virt.raw"
OUTPUT_DIR="$PROJECT_ROOT/build/release-assets"
RELEASE_TAG=""
PART_SIZE_MIB=${OMARCHY_EZVM_PART_SIZE_MIB:-1900}
RELEASE_REPOSITORY=${OMARCHY_EZVM_RELEASE_REPOSITORY:-everettjf/omarchy-aarch64-image}

fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }
absolute_existing_path() { (cd -- "$(dirname -- "$1")" && printf '%s/%s\n' "$PWD" "$(basename -- "$1")"); }
absolute_directory() { mkdir -p -- "$1"; (cd -- "$1" && printf '%s\n' "$PWD"); }
file_size() {
  local size
  size=$(stat --format=%s "$1" 2>/dev/null) || size=$(stat -f %z "$1")
  [[ $size =~ ^[0-9]+$ ]] || fail "could not determine file size: $1"
  printf '%s\n' "$size"
}

while (($#)); do
  case $1 in
    --tag) RELEASE_TAG=${2:?}; shift 2 ;;
    --image) IMAGE_PATH=$(absolute_existing_path "${2:?}"); shift 2 ;;
    --output) OUTPUT_DIR=$(absolute_directory "${2:?}"); shift 2 ;;
    *) fail "unknown option: $1" ;;
  esac
done

[[ $RELEASE_TAG =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "a valid --tag is required"
[[ -f $IMAGE_PATH ]] || fail "raw image not found: $IMAGE_PATH"
if [[ ! $PART_SIZE_MIB =~ ^[0-9]+$ ]] ||
  ((PART_SIZE_MIB <= 0 || PART_SIZE_MIB >= 2048)); then
  fail "part size must be between 1 and 2047 MiB"
fi
for command in awk cat dirname find gzip install jq mkdir python3 sed sha256sum split stat; do
  command -v "$command" >/dev/null || fail "missing required command: $command"
done

mkdir -p "$OUTPUT_DIR"
prefix="$OUTPUT_DIR/Omarchy-ezvm.sparse.gz.part-"
rm -f -- "$prefix"* "$OUTPUT_DIR/install-Omarchy-ezvm.command" \
  "$OUTPUT_DIR/ezvm-release-manifest.json"

printf 'Encoding the EZVM sparse stream, compressing, and splitting…\n'
"$PROJECT_ROOT/bin/encode-ezvm-sparse" "$IMAGE_PATH" |
  gzip -1 |
  split -d -a 2 -b "${PART_SIZE_MIB}m" - "$prefix"

parts=()
while IFS= read -r part; do parts+=("$part"); done < <(
  find "$OUTPUT_DIR" -maxdepth 1 -type f -name 'Omarchy-ezvm.sparse.gz.part-*' -print | sort
)
((${#parts[@]} > 0)) || fail "compression produced no parts"
image_sha=$(sha256sum "$IMAGE_PATH" | awk '{print $1}')
image_size=$(file_size "$IMAGE_PATH")
image_name=${IMAGE_PATH##*/}
[[ $image_name =~ ^[A-Za-z0-9._-]+$ ]] || fail "image filename contains unsupported characters"
archive_sha=$(cat -- "${parts[@]}" | sha256sum | awk '{print $1}')
archive_size=0
parts_json='[]'
for part in "${parts[@]}"; do
  name=${part##*/}
  checksum=$(sha256sum "$part" | awk '{print $1}')
  size=$(file_size "$part")
  archive_size=$((archive_size + size))
  parts_json=$(jq --arg name "$name" --arg sha256 "$checksum" --argjson size "$size" \
    '. + [{name: $name, size: $size, sha256: $sha256}]' <<<"$parts_json")
done

jq -n \
  --arg tag "$RELEASE_TAG" --arg repository "$RELEASE_REPOSITORY" \
  --arg image_sha256 "$image_sha" --argjson image_size "$image_size" \
  --arg archive_sha256 "$archive_sha" --argjson archive_size "$archive_size" \
  --argjson parts "$parts_json" '
  {
    schemaVersion: 1,
    kind: "io.github.everettjf.ezvm.preinstalled-image",
    architecture: "arm64",
    minimumEZVMVersion: "1.0.0",
    product: {id: "org.omarchy.aarch64", name: "Omarchy", version: $tag},
    disk: {
      format: "raw",
      virtualSize: $image_size,
      sha256: $image_sha256
    },
    archive: {
      compression: "ezvm-sparse-stream+gzip",
      compressedSize: $archive_size,
      sha256: $archive_sha256,
      parts: $parts
    },
    release: {repository: $repository, tag: $tag},
    virtualMachine: {
      name: "Omarchy",
      remark: "Omarchy AArch64 preinstalled image"
    }
  }' >"$OUTPUT_DIR/ezvm-release-manifest.json"

installer="$OUTPUT_DIR/install-Omarchy-ezvm.command"
{
  cat <<'HEADER'
#!/bin/bash
set -euo pipefail
fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }
for command in awk cat curl dirname gzip jq mkdir mktemp open perl shasum stat; do
  command -v "$command" >/dev/null 2>&1 || fail "missing required macOS command: $command"
done
HEADER
  printf "repository='%s'\ntag='%s'\n" "$RELEASE_REPOSITORY" "$RELEASE_TAG"
  cat <<'BODY_START'
destination=${1:-"$HOME/EZVM Virtual Machines/Omarchy.ezvm"}
[[ $destination == *.ezvm ]] || fail "destination must end in .ezvm"
[[ ! -e $destination ]] || fail "destination already exists: $destination"
ezvm_bin=${EZVM_CLI_EXECUTABLE:-$(command -v ezvm || true)}
[[ -n $ezvm_bin && -x $ezvm_bin ]] || fail "EZVM 1.0.0 or newer must be installed with Homebrew"
work=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-ezvm-install.XXXXXX")
cleanup() { rm -rf "$work"; }
trap cleanup EXIT
base_url=${OMARCHY_EZVM_RELEASE_BASE_URL:-"https://github.com/$repository/releases/download/$tag"}
manifest="$work/ezvm-release-manifest.json"
curl --fail --location --retry 3 --output "$manifest" "$base_url/ezvm-release-manifest.json"
jq -e '
  .schemaVersion == 1 and
  .kind == "io.github.everettjf.ezvm.preinstalled-image" and
  .architecture == "arm64" and
  .disk.format == "raw" and
  (.disk.virtualSize | type == "number") and
  (.disk.sha256 | test("^[0-9a-f]{64}$")) and
  .archive.compression == "ezvm-sparse-stream+gzip" and
  (.archive.sha256 | test("^[0-9a-f]{64}$")) and
  (.archive.parts | type == "array" and length > 0) and
  all(.archive.parts[]; (.name | test("^[A-Za-z0-9._-]+$")) and (.size | type == "number") and (.sha256 | test("^[0-9a-f]{64}$")))
' "$manifest" >/dev/null || fail "release manifest is invalid or unsupported"
image_name='Omarchy-ezvm.raw'
image_sha=$(jq -r '.disk.sha256' "$manifest")
image_size=$(jq -r '.disk.virtualSize' "$manifest")
archive_sha=$(jq -r '.archive.sha256' "$manifest")
decoder="$work/decode-ezvm-sparse"
cat >"$decoder" <<'EZVM_SPARSE_DECODER'
BODY_START
  cat "$PROJECT_ROOT/bin/decode-ezvm-sparse"
  cat <<'BODY'
EZVM_SPARSE_DECODER
downloaded=()
part_count=$(jq '.archive.parts | length' "$manifest")
for ((index = 0; index < part_count; index++)); do
  name=$(jq -r ".archive.parts[$index].name" "$manifest")
  expected_size=$(jq -r ".archive.parts[$index].size" "$manifest")
  expected_sha=$(jq -r ".archive.parts[$index].sha256" "$manifest")
  printf 'Downloading %s (%d/%d)…\n' "$name" "$((index + 1))" "$part_count"
  curl --fail --location --retry 3 --output "$work/$name" "$base_url/$name"
  actual_size=$(stat -f %z "$work/$name")
  [[ $actual_size == "$expected_size" ]] || fail "size mismatch: $name"
  actual=$(shasum -a 256 "$work/$name" | awk '{print $1}')
  [[ $actual == "$expected_sha" ]] || fail "checksum mismatch: $name"
  downloaded+=("$work/$name")
done
actual=$(cat "${downloaded[@]}" | shasum -a 256 | awk '{print $1}')
[[ $actual == "$archive_sha" ]] || fail "compressed image checksum mismatch"
raw="$work/$image_name"
cat "${downloaded[@]}" | gzip -dc | perl "$decoder" "$raw"
[[ -f $raw ]] || fail "sparse archive did not produce the expected raw image"
actual_size=$(stat -f %z "$raw")
[[ $actual_size == "$image_size" ]] || fail "raw image size mismatch"
actual=$(shasum -a 256 "$raw" | awk '{print $1}')
[[ $actual == "$image_sha" ]] || fail "raw image checksum mismatch"
mkdir -p "$(dirname "$destination")"
"$ezvm_bin" install-image "$manifest" --image "$raw" --destination "$destination" --timeout 300
if [[ ${OMARCHY_EZVM_SKIP_OPEN:-0} != 1 ]]; then open -a EZVM; fi
printf '\nInstalled Omarchy for EZVM: %s\n' "$destination"
BODY
} >"$installer"
chmod 0755 "$installer"

rm -f "$OUTPUT_DIR/SHA256SUMS"
(
  cd "$OUTPUT_DIR"
  files=()
  while IFS= read -r file; do files+=("$file"); done < <(
    find . -maxdepth 1 -type f ! -name SHA256SUMS -print | sed 's#^./##' | sort
  )
  sha256sum "${files[@]}" >SHA256SUMS
)
printf 'Prepared %d EZVM image part(s) in %s\n' "${#parts[@]}" "$OUTPUT_DIR"
