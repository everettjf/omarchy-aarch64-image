#!/bin/bash

set -euo pipefail

PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly PROJECT_ROOT
readonly BUNDLE_NAME=Omarchy-virt.utm
readonly ARCHIVE_NAME=Omarchy-virt.utm.zip
readonly INSTALLER_NAME=install-Omarchy-virt.command
readonly INSTALLER_ARCHIVE_NAME=Install-Omarchy-virt.zip
readonly TEMPLATE_DIR="$PROJECT_ROOT/utm/$BUNDLE_NAME"
readonly ICON_SOURCE="$PROJECT_ROOT/utm/icon.png.base64"

IMAGE_PATH="$PROJECT_ROOT/build/omarchy-aarch64-virt.qcow2"
PROVENANCE_PATH="$PROJECT_ROOT/build/image-provenance.txt"
OUTPUT_DIR=""
RELEASE_TAG=""
RELEASE_REPOSITORY=${OMARCHY_UTM_RELEASE_REPOSITORY:-everettjf/omarchy-aarch64-image}
PART_SIZE_MIB=${OMARCHY_UTM_PART_SIZE_MIB:-1900}
STAGE_ROOT=""

log() {
  printf '\033[32m==>\033[0m %s\n' "$*"
}

fail() {
  printf '\033[31mError:\033[0m %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: ./bin/package-utm-release --tag TAG [options]

Options:
  --tag TAG          GitHub Release tag embedded in the macOS installer
  --image PATH       QCOW2 image (default: build/omarchy-aarch64-virt.qcow2)
  --provenance PATH  Image provenance file (default: build/image-provenance.txt)
  --output DIR       Release asset directory (default: build/release/TAG)
  -h, --help         Show this help

The UTM archive is emitted as numbered parts below GitHub's 2 GiB per-asset
limit. Set OMARCHY_UTM_CONSUME_IMAGE=1 to remove the source QCOW2 after the
archive stream has been split successfully, which reduces peak CI disk usage.
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

absolute_path() {
  realpath -m -- "$1"
}

parse_args() {
  while (($#)); do
    case $1 in
      --tag)
        (($# >= 2)) || fail "--tag requires a value"
        [[ -z $RELEASE_TAG ]] || fail "--tag may only be specified once"
        RELEASE_TAG=$2
        shift 2
        ;;
      --image)
        (($# >= 2)) || fail "--image requires a path"
        IMAGE_PATH=$(absolute_path "$2")
        shift 2
        ;;
      --provenance)
        (($# >= 2)) || fail "--provenance requires a path"
        PROVENANCE_PATH=$(absolute_path "$2")
        shift 2
        ;;
      --output)
        (($# >= 2)) || fail "--output requires a directory"
        OUTPUT_DIR=$(absolute_path "$2")
        shift 2
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        fail "unknown option: $1"
        ;;
    esac
  done
}

cleanup() {
  local status=$?

  if [[ -n $STAGE_ROOT && $STAGE_ROOT == "${IMAGE_PATH%/*}"/.utm-release-stage.* &&
    -d $STAGE_ROOT ]]; then
    rm -rf -- "$STAGE_ROOT"
  fi
  return "$status"
}

validate_inputs() {
  local command manifest_base suffix

  [[ $RELEASE_TAG =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    fail "release tag must contain only letters, numbers, dots, underscores, and hyphens"
  [[ $RELEASE_REPOSITORY =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] ||
    fail "invalid GitHub release repository: $RELEASE_REPOSITORY"
  [[ $PART_SIZE_MIB =~ ^[0-9]+$ ]] || fail "part size must be a whole number of MiB"
  ((PART_SIZE_MIB >= 1 && PART_SIZE_MIB < 2048)) ||
    fail "part size must be between 1 and 2047 MiB"
  [[ -f $IMAGE_PATH ]] || fail "image not found: $IMAGE_PATH"
  [[ -f $PROVENANCE_PATH ]] || fail "image provenance not found: $PROVENANCE_PATH"
  manifest_base=${IMAGE_PATH%.qcow2}
  for suffix in all-packages.txt explicit-packages.txt packages.tsv orphans.txt; do
    [[ -f $manifest_base.$suffix ]] ||
      fail "image package inventory not found: $manifest_base.$suffix"
  done
  [[ -f $TEMPLATE_DIR/config.plist ]] || fail "UTM template config is missing"
  [[ -f $ICON_SOURCE ]] || fail "UTM template icon is missing"

  for command in awk base64 cat cp date find git install jq ln mktemp realpath \
    sha256sum split stat zip; do
    require_command "$command"
  done

  if [[ -z $OUTPUT_DIR ]]; then
    OUTPUT_DIR="$PROJECT_ROOT/build/release/$RELEASE_TAG"
  fi
  if [[ -d $OUTPUT_DIR ]] && find "$OUTPUT_DIR" -mindepth 1 -maxdepth 1 -print -quit |
    grep -q .; then
    fail "release output directory is not empty: $OUTPUT_DIR"
  fi
  mkdir -p "$OUTPUT_DIR"
}

stage_bundle() {
  local data_dir destination

  STAGE_ROOT=$(mktemp -d "${IMAGE_PATH%/*}/.utm-release-stage.XXXXXX")
  data_dir="$STAGE_ROOT/$BUNDLE_NAME/Data"
  mkdir -p "$data_dir"
  install -m644 "$TEMPLATE_DIR/config.plist" "$STAGE_ROOT/$BUNDLE_NAME/config.plist"
  base64 --decode "$ICON_SOURCE" >"$data_dir/icon.png"

  destination="$data_dir/omarchy-aarch64-virt.qcow2"
  if ! ln -- "$IMAGE_PATH" "$destination" 2>/dev/null; then
    cp --reflink=auto --sparse=always "$IMAGE_PATH" "$destination"
  fi

  [[ ! -e $data_dir/efi_vars.fd ]] || fail "UTM template unexpectedly contains EFI variables"
  [[ $(find "$STAGE_ROOT/$BUNDLE_NAME" -type f | wc -l) -eq 3 ]] ||
    fail "UTM staging bundle contains unexpected files"
}

stream_archive_parts() {
  local prefix="$OUTPUT_DIR/$ARCHIVE_NAME.part-"

  log "Streaming the UTM archive into ${PART_SIZE_MIB} MiB release parts"
  (
    cd -- "$STAGE_ROOT"
    zip -0 -q -r - "$BUNDLE_NAME"
  ) | split --bytes "${PART_SIZE_MIB}M" --numeric-suffixes=0 --suffix-length=2 - "$prefix"

  rm -rf -- "$STAGE_ROOT"
  STAGE_ROOT=""
}

write_installer() {
  local archive_sha=$1 installer="$OUTPUT_DIR/$INSTALLER_NAME"
  shift
  local -a parts=("$@")
  local part name checksum

  {
    cat <<'HEADER'
#!/bin/bash

set -euo pipefail

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

for command in awk cat curl ditto open shasum uuidgen; do
  command -v "$command" >/dev/null 2>&1 || fail "missing required macOS command: $command"
done
[[ -x /usr/libexec/PlistBuddy ]] || fail "missing /usr/libexec/PlistBuddy"
HEADER
    printf "release_repository='%s'\n" "$RELEASE_REPOSITORY"
    printf "release_tag='%s'\n" "$RELEASE_TAG"
    printf "archive_name='%s'\n" "$ARCHIVE_NAME"
    printf "archive_sha256='%s'\n" "$archive_sha"
    printf 'parts=(\n'
    for part in "${parts[@]}"; do
      printf "  '%s'\n" "${part##*/}"
    done
    printf ')\npart_sha256=(\n'
    for part in "${parts[@]}"; do
      checksum=$(sha256sum "$part" | awk '{print $1}')
      printf "  '%s'\n" "$checksum"
    done
    cat <<'BODY'
)

destination_root=${1:-"$HOME/Downloads"}
mkdir -p "$destination_root"
destination="$destination_root/Omarchy-virt.utm"
[[ ! -e $destination ]] || fail "destination already exists: $destination"

work=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-virt-install.XXXXXX")
cleanup() {
  rm -rf "$work"
}
trap cleanup EXIT

base_url="https://github.com/$release_repository/releases/download/$release_tag"
for index in "${!parts[@]}"; do
  name=${parts[$index]}
  path="$work/$name"
  printf 'Downloading %s (%d/%d)...\n' "$name" "$((index + 1))" "${#parts[@]}"
  curl --fail --location --retry 3 --output "$path" "$base_url/$name"
  actual=$(shasum -a 256 "$path" | awk '{print $1}')
  [[ $actual == "${part_sha256[$index]}" ]] || fail "checksum mismatch: $name"
done

archive="$work/$archive_name"
: >"$archive"
for name in "${parts[@]}"; do
  cat "$work/$name" >>"$archive"
  rm -f "$work/$name"
done
actual=$(shasum -a 256 "$archive" | awk '{print $1}')
[[ $actual == "$archive_sha256" ]] || fail "reconstructed UTM archive checksum mismatch"

extract_root="$work/extracted"
mkdir -p "$extract_root"
ditto -x -k "$archive" "$extract_root"
rm -f "$archive"
bundle="$extract_root/Omarchy-virt.utm"
[[ -f $bundle/config.plist ]] || fail "archive does not contain the UTM configuration"
[[ -f $bundle/Data/omarchy-aarch64-virt.qcow2 ]] || fail "archive does not contain the disk image"

# UTM creates fresh variable storage from its bundled AArch64 EDK2 template on
# first launch. Never carry firmware boot entries or state across users.
rm -f "$bundle/Data/efi_vars.fd"

plist=/usr/libexec/PlistBuddy
"$plist" -c "Set :Information:UUID $(uuidgen)" "$bundle/config.plist"
"$plist" -c "Set :Drive:0:Identifier $(uuidgen)" "$bundle/config.plist"
mac_seed=$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]')
mac=$(printf '02:%s:%s:%s:%s:%s' \
  "${mac_seed:0:2}" "${mac_seed:2:2}" "${mac_seed:4:2}" \
  "${mac_seed:6:2}" "${mac_seed:8:2}")
"$plist" -c "Set :Network:0:MacAddress $mac" "$bundle/config.plist"

mv "$bundle" "$destination"
printf '\nInstalled and personalized: %s\n' "$destination"
printf 'UTM will create clean EFI variable storage on first launch.\n'
open -a UTM "$destination"
BODY
  } >"$installer"

  chmod 0755 "$installer"
  (
    cd -- "$OUTPUT_DIR"
    zip -9 -q "$INSTALLER_ARCHIVE_NAME" "$INSTALLER_NAME"
  )
}

write_manifest() {
  local image_sha=$1 image_size=$2 archive_sha=$3 archive_size=$4
  shift 4
  local -a parts=("$@")
  local source_commit generated_at source_dirty part name checksum size parts_json

  source_commit=$(git -C "$PROJECT_ROOT" rev-parse HEAD)
  generated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  source_dirty=false
  git -C "$PROJECT_ROOT" diff --quiet --ignore-submodules -- || source_dirty=true
  git -C "$PROJECT_ROOT" diff --cached --quiet --ignore-submodules -- || source_dirty=true

  parts_json=$(
    for part in "${parts[@]}"; do
      name=${part##*/}
      checksum=$(sha256sum "$part" | awk '{print $1}')
      size=$(stat --format=%s "$part")
      jq -n --arg name "$name" --arg sha256 "$checksum" --argjson size "$size" \
        '{name: $name, size: $size, sha256: $sha256}'
    done | jq --slurp .
  )

  jq -n \
    --arg release_tag "$RELEASE_TAG" \
    --arg repository "$RELEASE_REPOSITORY" \
    --arg generated_at "$generated_at" \
    --arg source_commit "$source_commit" \
    --argjson source_dirty "$source_dirty" \
    --arg image_name "${IMAGE_PATH##*/}" \
    --arg image_sha256 "$image_sha" \
    --argjson image_size "$image_size" \
    --arg archive_name "$ARCHIVE_NAME" \
    --arg archive_sha256 "$archive_sha" \
    --argjson archive_size "$archive_size" \
    --argjson part_size_bytes "$((PART_SIZE_MIB * 1024 * 1024))" \
    --argjson parts "$parts_json" '
      {
        schema: 1,
        release_tag: $release_tag,
        repository: $repository,
        generated_at: $generated_at,
        source: {commit: $source_commit, dirty: $source_dirty},
        image: {name: $image_name, size: $image_size, sha256: $image_sha256},
        utm_archive: {
          name: $archive_name,
          size: $archive_size,
          sha256: $archive_sha256,
          part_size_bytes: $part_size_bytes,
          parts: $parts
        },
        template: {
          path: "utm/Omarchy-virt.utm",
          efi_variable_storage: "omitted-and-created-by-utm"
        }
      }
    ' >"$OUTPUT_DIR/release-manifest.json"
}

write_checksums() {
  local file
  local -a files=()

  while IFS= read -r file; do
    files+=("$file")
  done < <(find "$OUTPUT_DIR" -mindepth 1 -maxdepth 1 -type f \
    ! -name SHA256SUMS -printf '%f\n' | sort)
  (cd -- "$OUTPUT_DIR" && sha256sum "${files[@]}" >SHA256SUMS)
}

copy_image_metadata() {
  local manifest_base=${IMAGE_PATH%.qcow2}
  local inventory_stage

  install -m644 "$PROVENANCE_PATH" "$OUTPUT_DIR/image-provenance.txt"
  inventory_stage=$(mktemp -d "$OUTPUT_DIR/.package-inventory.XXXXXX")
  install -m644 "$manifest_base.all-packages.txt" "$inventory_stage/all-packages.txt"
  install -m644 "$manifest_base.explicit-packages.txt" "$inventory_stage/explicit-packages.txt"
  install -m644 "$manifest_base.packages.tsv" "$inventory_stage/packages.tsv"
  install -m644 "$manifest_base.orphans.txt" "$inventory_stage/orphans.txt"
  (
    cd -- "$inventory_stage"
    zip -9 -q "$OUTPUT_DIR/image-package-inventory.zip" \
      all-packages.txt explicit-packages.txt packages.tsv orphans.txt
  )
  rm -rf -- "$inventory_stage"
}

main() {
  local image_sha image_size archive_sha archive_size part
  local -a parts=()

  parse_args "$@"
  validate_inputs
  trap cleanup EXIT

  image_sha=$(sha256sum "$IMAGE_PATH" | awk '{print $1}')
  image_size=$(stat --format=%s "$IMAGE_PATH")
  stage_bundle
  stream_archive_parts

  while IFS= read -r part; do
    parts+=("$part")
  done < <(find "$OUTPUT_DIR" -mindepth 1 -maxdepth 1 -type f \
    -name "$ARCHIVE_NAME.part-*" -print | sort)
  ((${#parts[@]} > 0)) || fail "UTM archive did not produce any release parts"

  archive_sha=$(cat -- "${parts[@]}" | sha256sum | awk '{print $1}')
  archive_size=0
  for part in "${parts[@]}"; do
    archive_size=$((archive_size + $(stat --format=%s "$part")))
  done
  printf '%s  %s\n' "$archive_sha" "$ARCHIVE_NAME" >"$OUTPUT_DIR/$ARCHIVE_NAME.sha256"

  copy_image_metadata
  if [[ ${OMARCHY_UTM_CONSUME_IMAGE:-0} == 1 ]]; then
    log "Removing the source QCOW2 after successful archive streaming"
    rm -f -- "$IMAGE_PATH" "$IMAGE_PATH.sha256"
  fi

  write_installer "$archive_sha" "${parts[@]}"
  write_manifest "$image_sha" "$image_size" "$archive_sha" "$archive_size" "${parts[@]}"
  write_checksums
  if find "$OUTPUT_DIR" -mindepth 1 -maxdepth 1 -type f -empty -print -quit |
    grep -q .; then
    fail "GitHub Release assets must not be empty"
  fi

  log "Prepared ${#parts[@]} UTM archive part(s) in $OUTPUT_DIR"
  log "Users should download $INSTALLER_ARCHIVE_NAME and run $INSTALLER_NAME on macOS"
}

main "$@"
