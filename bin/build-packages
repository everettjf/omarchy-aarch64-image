#!/bin/bash

set -euo pipefail

PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly PROJECT_ROOT
readonly SOURCE_LIST="$PROJECT_ROOT/config/source-packages.aarch64"
readonly PREBUILT_MANIFEST="$PROJECT_ROOT/config/prebuilt-packages.aarch64"
readonly BUILD_ROOT="$PROJECT_ROOT/build"
readonly OUTPUT_DIR="$BUILD_ROOT/packages/aarch64"
readonly PREBUILT_CACHE="$BUILD_ROOT/cache/prebuilt-packages/aarch64"
readonly RECIPE_PATCH="$PROJECT_ROOT/patches/omarchy-pkgs-source-build.patch"
readonly LIMINE_PATCH="$PROJECT_ROOT/packages/limine-mkinitcpio-hook/limine-entry-tool-aarch64.patch"
readonly GRADLE_BOOTSTRAP_DIR="$PROJECT_ROOT/packages/gradle"
readonly PROJECT_RECIPES_DIR="$PROJECT_ROOT/packages/source"

# shellcheck disable=SC1091
source "$PROJECT_ROOT/sources.env"
# shellcheck disable=SC1091
source "$PROJECT_ROOT/lib/omarchy-source.sh"

SELECTED_PACKAGES=()

log() {
  printf '\033[32m==>\033[0m %s\n' "$*"
}

warn() {
  printf '\033[33mWarning:\033[0m %s\n' "$*" >&2
}

fail() {
  printf '\033[31mError:\033[0m %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: ./bin/build-packages [--package NAME ...] [--omarchy-source PATH]

Without --package, build every source-maintained package and refresh all image
artifacts. With --package, rebuild only the named source-maintained packages;
existing artifacts are exposed as a temporary dependency repository. Normal
builds fetch the pinned Omarchy AArch64 commit. --omarchy-source explicitly
uses a local checkout for development.
EOF
}

parse_args() {
  while (($#)); do
    case $1 in
      --package)
        (($# >= 2)) || fail "--package requires a package name"
        SELECTED_PACKAGES+=("$2")
        shift 2
        ;;
      --omarchy-source)
        (($# >= 2)) || fail "--omarchy-source requires a path"
        [[ -z $OMARCHY_SOURCE_OVERRIDE ]] || fail "--omarchy-source may only be specified once"
        OMARCHY_SOURCE_OVERRIDE=$2
        shift 2
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        fail "unknown option: $1"
        ;;
    esac
  done
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

read_list() {
  sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$1"
}

validate_prebuilt_manifest() {
  local package filename digest extra
  local -A expected=() seen=()

  while IFS= read -r package; do expected[$package]=1; done < <(read_list "$SOURCE_LIST")
  while read -r package filename digest extra; do
    [[ -n ${package:-} && -n ${filename:-} && -n ${digest:-} && -z ${extra:-} ]] ||
      fail "invalid prebuilt package manifest row"
    [[ -n ${expected[$package]:-} ]] ||
      fail "prebuilt package is not in $SOURCE_LIST: $package"
    [[ -z ${seen[$package]:-} ]] || fail "duplicate prebuilt package: $package"
    [[ $filename != */* && $filename == *.pkg.tar.* ]] ||
      fail "invalid prebuilt package filename: $filename"
    [[ $digest =~ ^[0-9a-f]{64}$ ]] ||
      fail "invalid SHA-256 digest for prebuilt package: $package"
    seen[$package]=1
  done < <(read_list "$PREBUILT_MANIFEST")
}

resolve_source_packages() {
  local package filename digest
  local -A prebuilt=()

  while read -r package filename digest; do
    prebuilt[$package]=1
  done < <(read_list "$PREBUILT_MANIFEST")
  while IFS= read -r package; do
    [[ -n ${prebuilt[$package]:-} ]] || printf '%s\n' "$package"
  done < <(read_list "$SOURCE_LIST")
}

download_prebuilt_packages() {
  local package filename expected actual destination partial metadata architecture

  validate_prebuilt_manifest
  mkdir -p "$PREBUILT_CACHE"
  while read -r package filename expected; do
    destination="$PREBUILT_CACHE/$filename"
    if [[ ! -f $destination ]]; then
      partial="$destination.part"
      rm -f -- "$partial"
      log "Downloading pinned AArch64 package $filename"
      curl --fail --location --retry 4 --retry-delay 2 \
        --output "$partial" "$OMARCHY_AARCH64_RELEASE_URL/$filename"
      actual=$(sha256sum "$partial" | awk '{print $1}')
      if [[ $actual != "$expected" ]]; then
        rm -f -- "$partial"
        fail "SHA-256 mismatch for prebuilt package: $filename"
      fi
      mv "$partial" "$destination"
    fi

    actual=$(sha256sum "$destination" | awk '{print $1}')
    [[ $actual == "$expected" ]] ||
      fail "cached prebuilt package has the wrong SHA-256: $destination"
    read -r metadata _ < <(pacman -Qp "$destination")
    [[ $metadata == "$package" ]] ||
      fail "$filename contains package '$metadata', expected '$package'"
    architecture=$(LC_ALL=C pacman -Qip "$destination" |
      awk -F: '$1 ~ /^Architecture[[:space:]]*$/ {gsub(/[[:space:]]/, "", $2); print $2; exit}')
    [[ $architecture == aarch64 || $architecture == any ]] ||
      fail "$filename has unsupported architecture: ${architecture:-unknown}"
  done < <(read_list "$PREBUILT_MANIFEST")
}

patch_set_id() {
  local recipe

  {
    sha256sum "$RECIPE_PATCH" "$LIMINE_PATCH" \
      "$GRADLE_BOOTSTRAP_DIR/PKGBUILD" "$GRADLE_BOOTSTRAP_DIR/package.json"
    while IFS= read -r -d '' recipe; do
      sha256sum "$recipe"
    done < <(find "$PROJECT_RECIPES_DIR" -type f -print0 | sort -z)
  } | sha256sum | cut -c1-12
}

stage_project_recipes() {
  local checkout=$1 recipe relative

  while IFS= read -r -d '' recipe; do
    relative=${recipe#"$PROJECT_RECIPES_DIR/"}
    install -D -m644 "$recipe" "$checkout/pkgbuilds/$relative"
  done < <(find "$PROJECT_RECIPES_DIR" -type f -print0 | sort -z)
}

prepare_recipe_checkout() {
  local checkout=$1 actual

  if [[ ! -d $checkout/.git ]]; then
    log "Cloning pinned Omarchy package recipes"
    git clone "$OMARCHY_PKGS_URL" "$checkout"
    git -C "$checkout" checkout --detach "$OMARCHY_PKGS_REF"
  fi

  actual=$(git -C "$checkout" rev-parse HEAD)
  [[ $actual == "$OMARCHY_PKGS_REF" ]] ||
    fail "$checkout is at $actual, expected $OMARCHY_PKGS_REF; remove that cache after reviewing it"

  if git -C "$checkout" apply --reverse --check "$RECIPE_PATCH" >/dev/null 2>&1; then
    log "Source-build recipe patch is already applied"
  else
    git -C "$checkout" apply --check "$RECIPE_PATCH" ||
      fail "the pinned omarchy-pkgs recipes no longer accept the local source-build patch"
    git -C "$checkout" apply "$RECIPE_PATCH"
  fi

  install -m644 "$LIMINE_PATCH" \
    "$checkout/pkgbuilds/limine-mkinitcpio-hook/limine-entry-tool-aarch64.patch"
  install -d -m755 "$checkout/pkgbuilds/gradle/.omarchy"
  install -m644 "$GRADLE_BOOTSTRAP_DIR/PKGBUILD" "$checkout/pkgbuilds/gradle/PKGBUILD"
  install -m644 "$GRADLE_BOOTSTRAP_DIR/package.json" \
    "$checkout/pkgbuilds/gradle/.omarchy/package.json"
  stage_project_recipes "$checkout"
}

omarchy_package_version() {
  local version revision short dirty="" dirty_digest path

  version=$OMARCHY_AARCH64_VERSION
  revision=$(omarchy_source_git rev-list --count HEAD)
  short=$(omarchy_source_git rev-parse --short=12 HEAD)
  if [[ $OMARCHY_SOURCE_DIRTY == yes ]]; then
    dirty_digest=$(
      {
        omarchy_source_git diff --binary HEAD --
        while IFS= read -r -d '' path; do
          printf 'untracked:%s\0' "$path"
          (cd "$OMARCHY_SOURCE_DIR" && sha256sum -- "$path")
        done < <(omarchy_source_git ls-files --others --exclude-standard -z)
      } | sha256sum | cut -c1-12
    )
    dirty=".dirty$dirty_digest"
  fi

  printf '%s.r%s.g%s%s' "$version" "$revision" "$short" "$dirty"
}

point_core_packages_at_source() {
  local checkout=$1 package_version=$2 commit package pkgbuild
  commit=$OMARCHY_SOURCE_COMMIT

  for package in omarchy omarchy-settings; do
    pkgbuild="$checkout/pkgbuilds/$package/PKGBUILD"
    [[ -f $pkgbuild ]] || fail "missing $pkgbuild"
    sed -Ei \
      -e "s/^_tag=.*/_tag=''/" \
      -e "s/^_commit=.*/_commit='$commit'/" \
      -e "s/^pkgver=.*/pkgver=$package_version/" \
      -e 's/^pkgrel=.*/pkgrel=1/' \
      "$pkgbuild"
  done
}

copy_artifacts() {
  local recipe_output=$1 recipe_repository=$2 package_file package filename digest source_dir
  local -A expected=() copied=()

  while IFS= read -r package; do expected[$package]=1; done < <(read_list "$SOURCE_LIST")
  mkdir -p "$OUTPUT_DIR"
  find "$OUTPUT_DIR" -maxdepth 1 -type f -name '*.pkg.tar.*' -delete

  while read -r package filename digest; do
    package_file="$PREBUILT_CACHE/$filename"
    [[ -f $package_file ]] || fail "prebuilt package is missing from cache: $filename"
    install -m644 "$package_file" "$OUTPUT_DIR/$filename"
    copied[$package]=1
  done < <(read_list "$PREBUILT_MANIFEST")

  # The upstream package builder skips packages that are already current in
  # its repository and cleans build-output before each run. Prefer packages
  # built during this invocation, then fill skipped packages from that repo.
  for source_dir in "$recipe_output" "$recipe_repository"; do
    while IFS= read -r -d '' package_file; do
      package=$(pacman -Qp "$package_file" | awk '{print $1; exit}')
      [[ -n ${expected[$package]:-} && -z ${copied[$package]:-} ]] || continue
      install -m644 "$package_file" "$OUTPUT_DIR/${package_file##*/}"
      copied[$package]=1
    done < <(find "$source_dir" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print0)
  done

  for package in "${!expected[@]}"; do
    [[ -n ${copied[$package]:-} ]] || fail "package build produced no artifact for $package"
  done
}

merge_built_artifacts() {
  local recipe_output=$1 package_file existing existing_name package
  local -A expected=()

  [[ -d $recipe_output ]] || return 0
  while IFS= read -r package; do expected[$package]=1; done < <(read_list "$SOURCE_LIST")
  mkdir -p "$OUTPUT_DIR"

  while IFS= read -r -d '' package_file; do
    package=$(pacman -Qp "$package_file" | awk '{print $1; exit}')
    [[ -n ${expected[$package]:-} ]] || continue
    while IFS= read -r -d '' existing; do
      existing_name=$(pacman -Qp "$existing" | awk '{print $1; exit}')
      [[ $existing_name != "$package" ]] || rm -f -- "$existing"
    done < <(find "$OUTPUT_DIR" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print0)
    install -m644 "$package_file" "$OUTPUT_DIR/${package_file##*/}"
  done < <(find "$recipe_output" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print0)
}

validate_output_artifacts() {
  local package package_file name
  local -A present=()

  while IFS= read -r -d '' package_file; do
    name=$(pacman -Qp "$package_file" | awk '{print $1; exit}')
    present[$name]=1
  done < <(find "$OUTPUT_DIR" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print0)
  while IFS= read -r package; do
    [[ -n ${present[$package]:-} ]] || fail "package artifact is missing after incremental build: $package"
  done < <(read_list "$SOURCE_LIST")
}

stage_dependency_repository() {
  local checkout=$1 package package_file name repo_dir
  shift
  local -A rebuilding=()

  for package in "$@"; do rebuilding[$package]=1; done
  repo_dir="$checkout/pkgs.omarchy.org/edge/aarch64"
  mkdir -p "$repo_dir"
  find "$repo_dir" -mindepth 1 -maxdepth 1 -delete

  while IFS= read -r -d '' package_file; do
    name=$(pacman -Qp "$package_file" | awk '{print $1; exit}')
    [[ -z ${rebuilding[$name]:-} ]] || continue
    install -m644 "$package_file" "$repo_dir/${package_file##*/}"
  done < <(find "$OUTPUT_DIR" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print0)

  compgen -G "$repo_dir/*.pkg.tar.*" >/dev/null ||
    fail "no existing package artifacts are available for an incremental dependency repository"
  (
    cd "$repo_dir"
    repo-add -q omarchy.db.tar.zst ./*.pkg.tar.*
    ln -sfn omarchy.db.tar.zst omarchy.db
  )
}

write_provenance() {
  local checkout=$1 package_version=$2
  {
    printf 'omarchy_source=%s\n' "$OMARCHY_SOURCE_COMMIT"
    printf 'omarchy_source_url=%s\n' "$OMARCHY_AARCH64_URL"
    printf 'omarchy_source_ref=%s\n' "$OMARCHY_AARCH64_REF"
    printf 'omarchy_source_kind=%s\n' "$OMARCHY_SOURCE_KIND"
    printf 'omarchy_source_dirty=%s\n' "$OMARCHY_SOURCE_DIRTY"
    printf 'omarchy_package_version=%s\n' "$package_version"
    printf 'omarchy_pkgs_source=%s\n' "$(git -C "$checkout" rev-parse HEAD)"
    printf 'prebuilt_source=%s\n' "$OMARCHY_AARCH64_RELEASE_URL"
    printf 'prebuilt_manifest_sha256=%s\n' "$(sha256sum "$PREBUILT_MANIFEST" | awk '{print $1}')"
    printf 'project_recipes_sha256=%s\n' "$(find "$PROJECT_RECIPES_DIR" -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')"
    printf 'built_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    sha256sum "$OUTPUT_DIR"/*.pkg.tar.*
  } >"$OUTPUT_DIR/provenance.txt"
}

main() {
  local checkout package_version patch_id recipe_output recipe_repository package build_status=0
  local -A source_package_set=() selected_seen=()
  local -a packages=() source_packages=() build_packages=()

  parse_args "$@"
  require_command docker
  require_command awk
  require_command cut
  require_command curl
  require_command git
  require_command pacman
  require_command repo-add
  require_command sed
  require_command sha256sum
  require_command realpath
  resolve_omarchy_source
  docker info >/dev/null 2>&1 || fail "Docker is unavailable or its daemon is not running"

  mapfile -t packages < <(read_list "$SOURCE_LIST")
  ((${#packages[@]} > 0)) || fail "$SOURCE_LIST contains no packages"
  validate_prebuilt_manifest
  mapfile -t source_packages < <(resolve_source_packages)
  for package in "${source_packages[@]}"; do source_package_set[$package]=1; done
  if ((${#SELECTED_PACKAGES[@]} > 0)); then
    for package in "${SELECTED_PACKAGES[@]}"; do
      [[ -n ${source_package_set[$package]:-} ]] ||
        fail "--package only accepts source-maintained packages: $package"
      [[ -z ${selected_seen[$package]:-} ]] || fail "duplicate --package: $package"
      selected_seen[$package]=1
    done
    build_packages=("${SELECTED_PACKAGES[@]}")
    [[ -z ${selected_seen[limine-mkinitcpio-hook]:-} ]] ||
      build_packages=(gradle "${build_packages[@]}")
  else
    build_packages=(gradle "${source_packages[@]}")
  fi

  patch_id=$(patch_set_id)
  checkout="$BUILD_ROOT/cache/omarchy-pkgs-${OMARCHY_PKGS_REF:0:12}-$patch_id"
  mkdir -p "$BUILD_ROOT/cache"
  prepare_recipe_checkout "$checkout"

  for package in "${source_packages[@]}"; do
    [[ -f $checkout/pkgbuilds/$package/PKGBUILD ]] ||
      fail "source package '$package' has no pinned PKGBUILD"
  done

  package_version=$(omarchy_package_version)
  [[ $package_version != *.*dirty* ]] ||
    warn "building an uncommitted Omarchy checkout as $package_version"
  point_core_packages_at_source "$checkout" "$package_version"
  download_prebuilt_packages

  if ((${#SELECTED_PACKAGES[@]} > 0)); then
    stage_dependency_repository "$checkout" "${SELECTED_PACKAGES[@]}"
  fi

  log "Reusing $(read_list "$PREBUILT_MANIFEST" | wc -l) pinned AArch64 packages"
  log "Building ${#build_packages[@]} AArch64 package targets from pinned recipes"
  if OMARCHY_SRC="$OMARCHY_SOURCE_DIR" "$checkout/bin/build" \
    --arch aarch64 \
    --mirror edge \
    --package "${build_packages[@]}"; then
    build_status=0
  else
    build_status=$?
  fi

  recipe_output="$checkout/build-output/edge/aarch64"
  recipe_repository="$checkout/pkgs.omarchy.org/edge/aarch64"
  if ((${#SELECTED_PACKAGES[@]} > 0)); then
    merge_built_artifacts "$recipe_output"
    ((build_status == 0)) || fail "one or more selected package builds failed; successful artifacts were retained"
    validate_output_artifacts
  elif ((build_status == 0)); then
    copy_artifacts "$recipe_output" "$recipe_repository"
  else
    merge_built_artifacts "$recipe_output"
    fail "one or more package builds failed; successful artifacts were retained for an incremental retry"
  fi
  write_provenance "$checkout" "$package_version"
  log "Packages are ready in $OUTPUT_DIR"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
