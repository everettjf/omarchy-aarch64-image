  provenance="$root/usr/share/omarchy-aarch64/image-build.txt"
  validate_base_provenance "$provenance"
  grep -qxF 'built_at=2026-09-04T00:00:00Z' "$provenance"
  grep -qxF 'rootfs_sha256=preserved' "$provenance"
  [[ $(grep -c '^ezvm_guest_agent_source_ref=' "$provenance") == 1 ]]
  grep -qxF "ezvm_guest_agent_source_ref=$AGENT_SOURCE_REF" "$provenance"
  grep -qxF "ezvm_integration_base_raw_sha256=$BASE_SHA256" "$provenance"
  cmp -s "$provenance" "$fixture/image-provenance.txt"
)
pass "integration-only rebake preserves OS provenance and binds the new Agent to its verified base"
(
  fixture=$(mktemp -d)
  trap 'rm -rf "$fixture"' EXIT
  truncate -s 16M "$fixture/base.raw"
  printf 'sparse fixture' | dd of="$fixture/base.raw" bs=1 seek=4096 conv=notrunc status=none
  "$ROOT/bin/encode-ezvm-sparse" "$fixture/base.raw" |
    gzip -1 -n >"$fixture/base.part"
  raw_sha=$(sha256sum "$fixture/base.raw" | awk '{print $1}')
  archive_sha=$(sha256sum "$fixture/base.part" | awk '{print $1}')
  archive_size=$(stat -c %s "$fixture/base.part")
  jq -n --arg raw_sha "$raw_sha" --arg archive_sha "$archive_sha" \
    --argjson archive_size "$archive_size" '
      {
        schemaVersion: 1,
        kind: "io.github.everettjf.ezvm.preinstalled-image",
        architecture: "arm64",
        release: {tag: "fixture-1"},
        disk: {format: "raw", sha256: $raw_sha, virtualSize: 16777216},
        archive: {
          compression: "ezvm-sparse-stream+gzip",
          sha256: $archive_sha,
          parts: [{name: "base.part", size: $archive_size, sha256: $archive_sha}]
        }
      }
    ' >"$fixture/ezvm-release-manifest.json"
  for suffix in all-packages.txt explicit-packages.txt packages.tsv; do
    printf 'fixture\n' >"$fixture/base.$suffix"
  done
  "$ROOT/bin/reconstruct-ezvm-release" \
    --assets "$fixture" --output "$fixture/result.raw" \
    --tag fixture-1 --sha256 "$raw_sha"
  cmp -s "$fixture/base.raw" "$fixture/result.raw"
  [[ -f $fixture/result.packages.tsv ]]
  printf 'tamper' >>"$fixture/base.part"
  if "$ROOT/bin/reconstruct-ezvm-release" \
    --assets "$fixture" --output "$fixture/tampered.raw" \
    --tag fixture-1 --sha256 "$raw_sha" >/dev/null 2>&1; then
    fail "tampered base release part was accepted"
  fi
  [[ ! -e $fixture/tampered.raw && ! -e $fixture/tampered.raw.part ]]
)
pass "pinned split release reconstruction verifies every layer and preserves sparse bytes"
grep -Fq 'base_release_tag:' "$ROOT/.github/workflows/release-image.yml" &&
  grep -Fq 'base_image_sha256:' "$ROOT/.github/workflows/release-image.yml" &&
  grep -Fq './bin/reconstruct-ezvm-release' "$ROOT/.github/workflows/release-image.yml" &&
  grep -Fq './bin/rebake-ezvm-integration-container' "$ROOT/.github/workflows/release-image.yml" ||
  fail "release workflow cannot produce a digest-pinned integration-only rebake"
