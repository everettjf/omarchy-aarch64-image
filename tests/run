(
  fixture=$(mktemp -d)
  watcher_pid=
  trap '[[ -z $watcher_pid ]] || kill "$watcher_pid" 2>/dev/null || true; rm -rf "$fixture"' EXIT
  mkdir -p "$fixture/drm/card0/device" "$fixture/drivers/virtio_gpu" "$fixture/drm/card0-Virtual-1"
  ln -s "$fixture/drivers/virtio_gpu" "$fixture/drm/card0/device/driver"
  printf 'connected\n' >"$fixture/drm/card0-Virtual-1/status"
  printf '1920x1080\n' >"$fixture/drm/card0-Virtual-1/modes"
  printf '#!/bin/bash\nprintf "%%s\\n" "$*" >>"$OMARCHY_EZVM_HYPRCTL_LOG"\n' >"$fixture/hyprctl"
  chmod 755 "$fixture/hyprctl"

  OMARCHY_EZVM_DRM_ROOT="$fixture/drm" \
    OMARCHY_EZVM_HYPRCTL="$fixture/hyprctl" \
    OMARCHY_EZVM_HYPRCTL_LOG="$fixture/hyprctl.log" \
    OMARCHY_EZVM_LOG="$fixture/display-watch.log" \
    OMARCHY_EZVM_POLL_INTERVAL=0.05 \
    XDG_RUNTIME_DIR="$fixture" \
    "$display_watch" &
  watcher_pid=$!
  sleep 0.1
  : >"$fixture/hyprctl.log"
  printf '2560x1440\n1920x1080\n' >"$fixture/drm/card0-Virtual-1/modes"
  for _ in {1..40}; do
    if grep -Fxq 'eval hl.monitor({ output = "Virtual-1", mode = "2560x1440", position = "auto", scale = "auto" })' "$fixture/hyprctl.log" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  [[ -s $fixture/hyprctl.log ]] || fail "EZVM display watcher did not react to a mode-list change"
  grep -Fxq 'eval hl.monitor({ output = "Virtual-1", mode = "2560x1440", position = "auto", scale = "auto" })' "$fixture/hyprctl.log" ||
    { sed -n '1,120p' "$fixture/hyprctl.log" >&2
      fail "EZVM display watcher did not apply the new DRM preferred mode to Hyprland"; }
  ! grep -Fxq reload "$fixture/hyprctl.log" ||
    fail "EZVM display watcher raced exact mode reconciliation with a Hyprland reload"
  kill "$watcher_pid" 2>/dev/null || true
  wait "$watcher_pid" 2>/dev/null || true
  watcher_pid=
  # The watcher may be inside its short external `sleep` when terminated. That
  # child briefly inherits the flock descriptor, so wait for one poll interval
  # before asserting that a replacement instance can acquire the lock.
  sleep 0.1

  rm "$fixture/drm/card0/device/driver"
  mkdir -p "$fixture/drivers/virtio-pci" "$fixture/modules/virtio_gpu"
  ln -s "$fixture/drivers/virtio-pci" "$fixture/drm/card0/device/driver"
  ln -s "$fixture/modules/virtio_gpu" "$fixture/drivers/virtio-pci/module"
  : >"$fixture/hyprctl.log"
  OMARCHY_EZVM_DRM_ROOT="$fixture/drm" \
    OMARCHY_EZVM_HYPRCTL="$fixture/hyprctl" \
    OMARCHY_EZVM_HYPRCTL_LOG="$fixture/hyprctl.log" \
    OMARCHY_EZVM_LOG="$fixture/display-watch.log" \
    OMARCHY_EZVM_POLL_INTERVAL=0.05 \
    XDG_RUNTIME_DIR="$fixture" \
    "$display_watch" &
  watcher_pid=$!
  for _ in {1..20}; do
    [[ -s $fixture/hyprctl.log ]] && break
    sleep 0.05
  done
  [[ -s $fixture/hyprctl.log ]] ||
    fail "EZVM display watcher rejected a virtio-pci device backed by virtio_gpu"
  kill "$watcher_pid" 2>/dev/null || true
  wait "$watcher_pid" 2>/dev/null || true
  watcher_pid=
)
pass "EZVM display watcher reacts to virtio-gpu mode changes"

(
  fixture=$(mktemp -d)
