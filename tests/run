#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly ROOT
OMARCHY_TEST_SOURCE=${OMARCHY_TEST_SOURCE:-"$ROOT/../omarchy-aarch64"}
OMARCHY_TEST_SOURCE=$(realpath "$OMARCHY_TEST_SOURCE")
readonly OMARCHY_TEST_SOURCE
PYTHONPYCACHEPREFIX=${PYTHONPYCACHEPREFIX:-$(mktemp -d)}
export PYTHONPYCACHEPREFIX
trap 'rm -rf "$PYTHONPYCACHEPREFIX"' EXIT

[[ -d $OMARCHY_TEST_SOURCE/.git ]] || {
  echo "FAIL: set OMARCHY_TEST_SOURCE to an omarchy-aarch64 checkout" >&2
  exit 1
}

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

pass() {
  echo "PASS: $*"
}

while IFS= read -r script; do
  case $(head -1 "$script") in
    *python*) python3 -m py_compile "$script" || fail "Python syntax: ${script#$ROOT/}" ;;
    *perl*) perl -c "$script" || fail "Perl syntax: ${script#$ROOT/}" ;;
    *) bash -n "$script" || fail "Bash syntax: ${script#$ROOT/}" ;;
  esac
done < <(find "$ROOT/bin" -type f -print; find "$ROOT/profiles" -type f -perm -111 -print)
bash -n "$OMARCHY_TEST_SOURCE/install/user/mise-work.sh"
bash -n "$OMARCHY_TEST_SOURCE/install/hardware/all.sh"
bash -n "$OMARCHY_TEST_SOURCE/install/hardware/virtual-machine.sh"
bash -n "$OMARCHY_TEST_SOURCE/install/post-install/pacman.sh"
  bash -n "$OMARCHY_TEST_SOURCE/bin/omarchy-provision-owner"
  grep -q 'failed to discard unused Btrfs extents' "$ROOT/bin/build-image" ||
    fail "image build does not require a successful final filesystem trim"
  grep -q 'raw image is not sparse after trim' "$ROOT/bin/build-image" ||
    fail "image build does not enforce sparse raw output"
pass "all project and modified runtime scripts parse as Bash"

(
  # shellcheck source=../bin/build-image
  source "$ROOT/bin/build-image"
  fixture=$(mktemp -d)
  trap 'rm -rf "$fixture"' EXIT

  MOUNT_DIR="$fixture/root"
  NODE_TARBALL="$fixture/node.tar.gz"
  mkdir -p \
    "$MOUNT_DIR/usr/bin" \
    "$MOUNT_DIR/usr/share/omarchy/install/provisioning"
  touch "$NODE_TARBALL"
  printf '#!/bin/sh\n' >"$MOUNT_DIR/usr/bin/omarchy-provision-owner"
  chmod 755 "$MOUNT_DIR/usr/bin/omarchy-provision-owner"
  touch "$MOUNT_DIR/usr/share/omarchy/install/provisioning/omarchy-provision-owner.service"
  cp "$OMARCHY_TEST_SOURCE/install/provisioning/setup-form.sh" \
    "$MOUNT_DIR/usr/share/omarchy/install/provisioning/setup-form.sh"

  stage_first_boot_provisioning

  setup_form="$MOUNT_DIR/usr/share/omarchy/install/provisioning/setup-form.sh"
  ! grep -Fq 'timedatectl list-timezones' "$setup_form" ||
    fail "staged first-boot form still queries timezones through D-Bus"
  [[ $(grep -Fc "zone1970.tab | sort -u" "$setup_form") == 2 ]] ||
    fail "staged first-boot form does not use the local timezone database twice"
  bash -n "$setup_form"
  pass "first-boot timezone picker is independent of the system bus"
)


(
  fixture=$(mktemp -d)
  trap 'rm -rf "$fixture"' EXIT
  head -c 2560000 /dev/urandom >"$fixture/test.raw"
  OMARCHY_EZVM_PART_SIZE_MIB=1 "$ROOT/bin/package-ezvm-release" \
    --tag v4.0.1-test.1 \
    --image "$fixture/test.raw" \
    --output "$fixture/release" >/dev/null
  (cd "$fixture/release" && sha256sum --check SHA256SUMS >/dev/null) ||
    fail "EZVM release asset checksums are invalid"
  bash -n "$fixture/release/install-Omarchy-ezvm.command"
  [[ -x $fixture/release/install-Omarchy-ezvm.command ]] ||
    fail "macOS EZVM installer is not executable"
  mapfile -t parts < <(find "$fixture/release" -maxdepth 1 -type f \
    -name 'Omarchy-ezvm.sparse.gz.part-*' -print | sort)
  ((${#parts[@]} >= 2)) || fail "EZVM release packager did not split a multi-part fixture"
  cat -- "${parts[@]}" | gzip -dc | perl "$ROOT/bin/decode-ezvm-sparse" \
    "$fixture/reconstructed.raw"
  cmp "$fixture/test.raw" "$fixture/reconstructed.raw" ||
    fail "EZVM sparse stream does not reconstruct the source disk byte-for-byte"
  jq -e '
    .schemaVersion == 1 and
    .kind == "io.github.everettjf.ezvm.preinstalled-image" and
    .product.id == "org.omarchy.aarch64" and
    .product.version == "v4.0.1-test.1" and
    .architecture == "arm64" and
    .minimumEZVMVersion == "1.0.0" and
    .disk.format == "raw" and
    (.disk.virtualSize | type == "number") and
    (.disk.sha256 | test("^[0-9a-f]{64}$")) and
    .archive.compression == "ezvm-sparse-stream+gzip" and
    (.archive.parts | length) > 0 and
    .thumbnail.name == "Omarchy-thumbnail.png" and
    .thumbnail.mediaType == "image/png" and
    (.thumbnail.size | type == "number" and . > 0) and
    (.thumbnail.sha256 | test("^[0-9a-f]{64}$")) and
    .virtualMachine.name == "Omarchy"
  ' "$fixture/release/ezvm-release-manifest.json" >/dev/null ||
    fail "EZVM release manifest is invalid"
  grep -q 'decode-ezvm-sparse' "$fixture/release/install-Omarchy-ezvm.command" ||
    fail "EZVM installer does not embed the sparse stream decoder"
  grep -Fq 'install-image "$manifest"' "$fixture/release/install-Omarchy-ezvm.command" ||
    fail "EZVM installer does not use the public install-image command"
  grep -Fq 'Verifying the complete compressed image' "$fixture/release/install-Omarchy-ezvm.command" ||
    fail "EZVM installer does not explain the complete archive verification stage"
  grep -Fq 'Reconstructing the 64 GiB sparse disk' "$fixture/release/install-Omarchy-ezvm.command" ||
    fail "EZVM installer does not explain the sparse reconstruction stage"
  grep -Fq 'Verifying the reconstructed 64 GiB disk' "$fixture/release/install-Omarchy-ezvm.command" ||
    fail "EZVM installer does not explain the raw disk verification stage"
  grep -Fq 'Importing Omarchy into EZVM' "$fixture/release/install-Omarchy-ezvm.command" ||
    fail "EZVM installer does not explain the EZVM import stage"
  grep -Fq -- '--thumbnail "$thumbnail"' "$fixture/release/install-Omarchy-ezvm.command" ||
    fail "EZVM installer does not install the bundled thumbnail"
  [[ -s $fixture/release/Omarchy-thumbnail.png ]] ||
    fail "EZVM release does not include the Omarchy thumbnail"
  if find "$fixture/release" -maxdepth 1 -type f -empty -print -quit | grep -q .; then
    fail "EZVM release contains a zero-byte asset rejected by GitHub"
  fi
  if find "$fixture/release" -maxdepth 1 -type f -print | grep -E -i 'utm|qcow2'; then
    fail "EZVM release packager emitted a removed UTM/QCOW2 asset"
  fi
  ! grep -Fq "image_sha='" "$fixture/release/install-Omarchy-ezvm.command" ||
    fail "EZVM installer still embeds a second copy of manifest checksums"
  pass "EZVM release packager produces verified split raw assets and installer"
)

if command -v shellcheck >/dev/null 2>&1; then
  bash_scripts=()
  while IFS= read -r script; do
    [[ $(head -1 "$script") == *bash* ]] && bash_scripts+=("$script")
  done < <(find "$ROOT/bin" -type f -print)
  shellcheck "${bash_scripts[@]}" "$ROOT"/profiles/aarch64-virt/overlay/usr/lib/omarchy-aarch64/grow-root
  pass "project scripts pass shellcheck"
fi

(
  # shellcheck source=../bin/build-image
  source "$ROOT/bin/build-image"
  fixture=$(mktemp -d)
  trap 'rm -rf "$fixture"' EXIT

  printf '%s\n' keep from-repository excluded old >"$fixture/base"
  printf '%s\n' from-repository >"$fixture/repository"
  printf '%s\n' excluded >"$fixture/excluded"
  printf '%s\n' 'old replacement' >"$fixture/replacements"
  printf '%s\n' runtime keep >"$fixture/runtime"

  mapfile -t resolved < <(
    resolve_official_packages \
      "$fixture/base" "$fixture/repository" "$fixture/excluded" \
      "$fixture/replacements" "$fixture/runtime"
  )
  [[ ${resolved[*]} == "keep replacement runtime" ]] ||
    fail "package resolution produced: ${resolved[*]}"
  pass "package resolution separates repository/unsupported targets and applies replacements"

  select_profile --profile aarch64-virt
  [[ $PROFILE_DIR == "$ROOT/profiles/aarch64-virt" ]] || fail "profile directory was not selected"
  [[ $OUTPUT_PATH == "$ROOT/build/omarchy-aarch64-ezvm.raw" ]] ||
    fail "profile default output is incorrect: $OUTPUT_PATH"
  validate_remove_package_patterns

  MODULES=(virtio_blk thunderbolt virtio_gpu)
  HOOKS=(base udev microcode autodetect plymouth filesystems)
  # shellcheck source=/dev/null
  source "$PROFILE_DIR/overlay/etc/mkinitcpio.conf.d/zz-omarchy-aarch64-virt.conf"
  [[ ${MODULES[*]} == "virtio_blk virtio_gpu" ]] ||
    fail "aarch64-virt mkinitcpio module filter produced: ${MODULES[*]}"
  [[ ${HOOKS[*]} == "base udev autodetect plymouth filesystems" ]] ||
    fail "aarch64-virt mkinitcpio hook filter produced: ${HOOKS[*]}"

  MOUNT_DIR="$fixture/target"
  hook_dir="$MOUNT_DIR/etc/pacman.d/hooks"
  hook_name=90-mkinitcpio-install.hook
  mkdir -p "$hook_dir"
  printf 'original hook\n' >"$hook_dir/$hook_name"
  mask_target_boot_hooks "$hook_name"
  is_devnull_symlink "$hook_dir/$hook_name" || fail "boot hook was not masked"
  [[ -f $hook_dir/$hook_name.omarchy-image-backup ]] ||
    fail "boot hook was not preserved while masked"
  unmask_target_boot_hooks "$hook_name"
  [[ $(<"$hook_dir/$hook_name") == "original hook" ]] ||
    fail "boot hook was not restored byte-for-byte"
  assert_target_boot_hooks_restored

  printf '[core]\nInclude = /etc/pacman.d/mirrorlist\n' >"$MOUNT_DIR/etc/pacman.conf"
  write_omarchy_repository_configuration
  grep -qxF 'Include = /etc/pacman.d/omarchy-aarch64.conf' \
    "$MOUNT_DIR/etc/pacman.conf" || fail "signed repository include was not installed"
  grep -qxF 'SigLevel = Required' "$MOUNT_DIR/etc/pacman.d/omarchy-aarch64.conf" ||
    fail "signed repository does not require signatures"
  write_omarchy_repository_configuration file:///run/omarchy-aarch64-repository
  grep -qxF 'Server = file:///run/omarchy-aarch64-repository' \
    "$MOUNT_DIR/etc/pacman.d/omarchy-aarch64.conf" ||
    fail "local signed repository cannot be selected during development builds"
  write_omarchy_repository_configuration
  grep -qxF "Server = $OMARCHY_AARCH64_REPOSITORY_URL" \
    "$MOUNT_DIR/etc/pacman.d/omarchy-aarch64.conf" ||
    fail "development builds do not restore the public update repository"
  bash -n "$MOUNT_DIR/etc/skel/.config/omarchy/hooks/pre-refresh-pacman.d/omarchy-aarch64-repository"

  for package in kdenlive libreoffice-fresh moonlight-qt hyprsunset gpu-screen-recorder; do
    grep -qx "$package" "$PROFILE_DIR/excluded-packages" ||
      fail "aarch64-virt still installs unsupported/oversized package: $package"
  done
  for package in clang llvm docker docker-buildx docker-compose lazydocker mariadb-libs \
    postgresql-libs python-poetry-core ruby tree-sitter-cli; do
    if grep -qx "$package" "$PROFILE_DIR/excluded-packages"; then
      fail "aarch64-virt still excludes an upstream development package: $package"
    fi
  done
  for package in dotnet-runtime-bin obsidian pinta tensaku tzupdate ufw-docker tobi-try; do
    grep -qx "$package" "$ROOT/config/omarchy-packages.aarch64" ||
      fail "required Omarchy repository package is not selected: $package"
  done
  for package in dotnet-runtime obsidian pinta tensaku tzupdate; do
    if grep -qx "$package" "$PROFILE_DIR/excluded-packages"; then
      fail "supported AArch64 desktop package remains excluded: $package"
    fi
  done
  for package in gst-plugin-pipewire pipewire pipewire-alsa pipewire-audio pipewire-jack \
    pipewire-pulse wireplumber; do
    grep -qx "$package" "$PROFILE_DIR/runtime-packages" ||
      fail "aarch64-virt audio stack is missing: $package"
  done

  shell_defaults=$(jq -f "$PROFILE_DIR/shell-defaults.jq" \
    "$OMARCHY_TEST_SOURCE/config/omarchy/shell.json")
  jq -e '
    ([.bar.layout.left[], .bar.layout.center[], .bar.layout.right[]]
      | map(select(.id == "omarchy.indicators"))[0].items)
      == ["Dictation", "Reminder", "Dnd", "StayAwake"]
    and (.disabledPlugins | index("omarchy.nightlight") != null)
  ' <<<"$shell_defaults" >/dev/null ||
    fail "aarch64-virt shell defaults retain Night Light or Screen Recording"

  output_fixture="$fixture/output.raw"
  OUTPUT_PATH="$output_fixture"
  IMAGE_FORMAT=raw
  FORCE=1
  : >"$output_fixture"
  : >"$output_fixture.part"
  validate_outputs
  [[ -e $output_fixture ]] || fail "--force discarded the previous image before replacement"
  [[ ! -e $output_fixture.part ]] || fail "stale image packaging partial was not removed"

  printf 'replacement image\n' >"$output_fixture.part"
  finalize_image_artifact "$output_fixture.part" "$output_fixture"
  [[ $(<"$output_fixture") == "replacement image" ]] ||
    fail "atomic image finalization did not replace the destination"
  (cd "$fixture" && sha256sum -c output.raw.sha256 >/dev/null) ||
    fail "atomic image finalization published an invalid checksum"

  target_chroot() {
    printf '%s\n' base bindfs dhcpcd ex-vi-compat haveged linux-aarch64 linux-firmware \
      linux-firmware-amdgpu nano net-tools netctl omarchy-spice-guest-tools \
      qemu-guest-agent sof-firmware spice-vdagent vulkan-virtio
  }
  mapfile -t removed < <(resolve_profile_removed_packages)
  [[ ${removed[*]} == "bindfs dhcpcd ex-vi-compat haveged linux-firmware linux-firmware-amdgpu nano net-tools netctl qemu-guest-agent sof-firmware vulkan-virtio" ]] ||
    fail "profile removal rules selected: ${removed[*]}"
  pass "aarch64-virt owns its VM desktop, audio stack, shell, and package-removal policy"
)

comm -12 \
  <(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$ROOT/config/omarchy-packages.aarch64" | sort) \
  <(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$ROOT/profiles/aarch64-virt/excluded-packages" | sort) |
  grep -q . && fail "a package is both repository-managed and excluded"
pass "AArch64 repository and exclusion manifests are disjoint"

(
  # shellcheck source=../bin/build-image
  source "$ROOT/bin/build-image"
  fixture=$(mktemp -d)
  trap 'rm -rf "$fixture"' EXIT
  packages_json=$(
    read_list "$ROOT/config/omarchy-packages.aarch64" |
      jq -R --arg source "$OMARCHY_AARCH64_REF" '
        {name: ., version: (if . == "omarchy" then
          "4.0.1.r1.g" + ($source[0:12]) + "-1"
        else "1-1" end)}
      ' | jq --slurp .
  )
  jq -n \
    --arg fingerprint "$OMARCHY_AARCH64_SIGNING_FINGERPRINT" \
    --argjson packages "$packages_json" '
      {
        schema: 2,
        generated_at: "2026-08-26T00:00:00Z",
        signing_fingerprint: $fingerprint,
        state: {
          schema: 1,
          architecture: "aarch64",
          channel: "stable",
          input_sha256: ("a" * 64),
          official_database: "https://pkgs.omarchy.org/stable/x86_64/omarchy.db.tar.zst",
          packages: $packages
        },
        packages: ($packages | map(.name + "-" + .version + "-aarch64.pkg.tar.zst"))
      }
    ' >"$fixture/repository-manifest.json"
  OMARCHY_SOURCE_COMMIT=$OMARCHY_AARCH64_REF
  validate_omarchy_repository_manifest "$fixture/repository-manifest.json"
  [[ $OMARCHY_REPOSITORY_OMARCHY_VERSION == 4.0.1.r1.g"${OMARCHY_AARCH64_REF:0:12}"-1 ]] ||
    fail "repository/source version boundary was not captured"

  jq -n \
    --arg fingerprint "$OMARCHY_AARCH64_SIGNING_FINGERPRINT" \
    --arg source "$OMARCHY_AARCH64_REF" \
    --argjson packages "$packages_json" '
      {
        schema: 1,
        architecture: "aarch64",
        channel: "stable",
        commit: ("b" * 40),
        generated_at: "2026-08-30T00:00:00Z",
        signing_fingerprint: $fingerprint,
        validation_mode: "incremental",
        package_base_count: ($packages | length),
        packages: ($packages | map(.name + "-" + .version + "-aarch64.pkg.tar.zst"))
      }
    ' >"$fixture/repository-manifest-v1.json"
  validate_omarchy_repository_manifest "$fixture/repository-manifest-v1.json"
  [[ $OMARCHY_REPOSITORY_OMARCHY_VERSION == 4.0.1.r1.g"${OMARCHY_AARCH64_REF:0:12}"-1 ]] ||
    fail "schema-1 repository/source version boundary was not captured"
  pass "signed stable repository manifests are complete and match the pinned Omarchy source"
)

mapfile -t image_profiles < <(
  find "$ROOT/profiles" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
)
[[ ${image_profiles[*]} == aarch64-virt ]] ||
  fail "the current release must expose only the aarch64-virt image profile"
pass "the current release exposes only the aarch64-virt image profile"

grep -Fxq 'ENABLE_UKI=yes' "$OMARCHY_TEST_SOURCE/etc/limine-entry-tool.d/omarchy-uki.conf" ||
  fail "the AArch64 fork does not enable Omarchy's UKI boot path"
if grep -Eq '^(ENABLE_UKI|FIND_BOOTLOADERS)=' \
  "$OMARCHY_TEST_SOURCE/default/limine/default.conf"; then
  fail "the AArch64 fork overrides Omarchy's UKI or bootloader-discovery defaults"
fi
if grep -Eq '^[[:space:]]*(protocol: linux|path: boot\(\):/Image|module_path:)' \
  "$OMARCHY_TEST_SOURCE/default/limine/limine.conf"; then
  fail "the AArch64 fork still carries a static kernel/initramfs boot entry"
fi
for package in limine-mkinitcpio-hook; do
  grep -qx "$package" "$ROOT/config/omarchy-packages.aarch64" ||
    fail "signed repository package is not selected: $package"
done
pass "aarch64-virt consumes its adapted Limine package from the signed repository"

grep -Fq 'plymouth-set-default-theme omarchy' "$ROOT/bin/build-image" ||
  fail "image assembly does not explicitly select the Omarchy boot theme"
grep -Fq 'LIMINE_FORCE_UEFI=yes limine-update' "$ROOT/bin/build-image" ||
  fail "image assembly does not build the AArch64 UKI inside its offline chroot"
grep -Fq 'boot/EFI/Linux/omarchy_linux.efi' "$ROOT/bin/build-image" ||
  fail "image validation does not require the stable Omarchy UKI"
grep -Fq 'omarchy-ezvm-ensure-bootable' "$ROOT/bin/build-image" ||
  fail "image assembly does not install a direct Omarchy UKI fallback"
grep -Fq 'EFI/BOOT/BOOTAA64.EFI' "$ROOT/bin/build-image" ||
  fail "image validation does not require the standard AArch64 EFI fallback"
grep -Fq 'Target = limine' \
  "$ROOT/profiles/aarch64-virt/overlay/usr/share/libalpm/hooks/zzzz-omarchy-ezvm-boot-fallback.hook" ||
  fail "system updates do not refresh the EZVM EFI fallback"
grep -Fq 'EFI/Linux/omarchy_linux.efi' \
  "$ROOT/profiles/aarch64-virt/overlay/usr/local/sbin/omarchy-ezvm-ensure-bootable" ||
  fail "the fallback repair helper does not source the Omarchy UKI"
grep -Fq "grep -Eq '^==> ERROR:|^ERROR:'" "$ROOT/bin/build-image" ||
  fail "native AArch64 image assembly accepts UKI build errors"
grep -Fq '== thunderbolt' \
  "$ROOT/profiles/aarch64-virt/overlay/etc/mkinitcpio.conf.d/zz-omarchy-aarch64-virt.conf" ||
  fail "aarch64-virt still requests the physical Thunderbolt kernel module"
grep -Fq '== microcode' \
  "$ROOT/profiles/aarch64-virt/overlay/etc/mkinitcpio.conf.d/zz-omarchy-aarch64-virt.conf" ||
  fail "aarch64-virt still requests the x86 microcode mkinitcpio hook"
grep -Fq 'usr/share/plymouth/themes/omarchy/omarchy.plymouth' "$ROOT/bin/build-image" ||
  fail "image validation does not require the Omarchy Plymouth theme"
grep -Fq 'usr/bin/plymouthd' "$ROOT/bin/build-image" ||
  fail "image validation does not inspect the initramfs for Plymouth"
grep -Fq 'console=ttyAMA0,115200 plymouth.ignore-serial-consoles' "$ROOT/bin/build-image" ||
  fail "the virtual serial console does not suppress the graphical Plymouth splash"
grep -Fq 'multi-user.target.wants/limine-snapper-sync.service' "$ROOT/bin/build-image" ||
  fail "image validation does not require Limine snapshot synchronization"
grep -Fq 'stop_target_background_helpers || true' "$ROOT/bin/build-image" ||
  fail "failed image builds do not stop chroot helpers before unmounting"
grep -Fq 'assert_target_boot_hooks_restored' "$ROOT/bin/build-image" ||
  fail "image assembly does not verify that deferred boot hooks were restored"
grep -Fq 'btrfs quota disable /' "$ROOT/bin/build-image" ||
  fail "image assembly does not match the official post-Limine quota policy"
grep -Fq 'target_chroot pacman -Qqe' "$ROOT/bin/build-image" ||
  fail "successful images do not publish their exact explicit package inventory"
grep -Fq 'target_chroot expac -Q' "$ROOT/bin/build-image" ||
  fail "successful images do not publish an auditable package manifest"
pass "the complete Omarchy UKI, primary Limine, and Plymouth boot experience is enforced"

[[ ! -e $ROOT/profiles/aarch64-virt/overlay/etc/systemd/system/omarchy-aarch64-setup-direct-boot.service ]] ||
  fail "the VM profile still enables direct UKI boot automatically"
[[ ! -e $ROOT/profiles/aarch64-virt/overlay/usr/lib/omarchy-aarch64/setup-direct-boot ]] ||
  fail "the VM profile still ships its own automatic direct-boot helper"
! grep -Fq 'omarchy-aarch64-setup-direct-boot' "$ROOT/bin/build-image" ||
  fail "image assembly still registers direct UKI boot automatically"
grep -Fq 'gum confirm "Setup direct boot' "$OMARCHY_TEST_SOURCE/bin/omarchy-setup-direct-boot" ||
  fail "the upstream user-selected Direct Boot command is unavailable"
pass "Limine is the default path and direct UKI boot remains user-selected"

grep -Eq '^\^linux-firmware\(\$\|-\)$' "$ROOT/profiles/aarch64-virt/remove-package-patterns" ||
  fail "aarch64-virt does not exclude linux-firmware and its split packages"
grep -Fq 'resolve_profile_removed_packages' "$ROOT/bin/build-image" ||
  fail "image validation does not enforce profile package removals"
for removed in qemu-guest-agent vulkan-virtio; do
  ! grep -qx "$removed" "$ROOT/profiles/aarch64-virt/runtime-packages" ||
    fail "EZVM-only profile still installs $removed"
done
grep -qx 'spice-vdagent' "$ROOT/profiles/aarch64-virt/runtime-packages" ||
  fail "EZVM profile does not install the SPICE desktop agent"
grep -qx 'omarchy-spice-guest-tools' "$ROOT/config/omarchy-packages.aarch64" ||
  fail "EZVM profile does not install Omarchy's SPICE session integration"
[[ ! -e $ROOT/utm ]] || fail "EZVM-only repository still contains a UTM template"
[[ ! -e $ROOT/bin/package-utm-release ]] || fail "UTM release packager still exists"
[[ ! -e $ROOT/bin/run-image ]] || fail "QEMU image runner still exists"
if grep -R -E -i 'package-utm|\.qcow2|hostshare|[[:space:]]9p[[:space:]]' \
  "$ROOT/bin" "$ROOT/config" "$ROOT/.github/workflows" >/dev/null ||
  find "$ROOT/profiles" -type f ! -name remove-package-patterns -exec \
    grep -E -i 'package-utm|\.qcow2|hostshare|[[:space:]]9p[[:space:]]' {} + \
    >/dev/null; then
  fail "EZVM-only runtime or release pipeline still contains UTM/QCOW2/SPICE/9p support"
fi
pass "EZVM profile retains SPICE clipboard support while excluding QEMU, UTM, and 9p integration"
grep -Fq -- '--continue-at -' "$ROOT/bin/build-image" ||
  fail "rolling image downloads cannot resume after interruption"
grep -Fq 'partial="$2.part"' "$ROOT/bin/build-image" ||
  fail "rolling image downloads are not staged atomically"
grep -Fq 'PACMAN_CACHE_DIR="$CACHE_DIR/pacman-aarch64"' "$ROOT/bin/build-image" ||
  fail "target package downloads are not retained across image build retries"
grep -Fq 'reclaim_packaging_space' "$ROOT/bin/build-image" &&
  grep -Fq 'OMARCHY_IMAGE_LOW_DISK=${OMARCHY_IMAGE_LOW_DISK:-0}' \
    "$ROOT/bin/build-image-container" ||
  fail "CI cannot reclaim transient package caches before sparse raw packaging"
grep -Fq 'runs-on: ubuntu-24.04-arm' "$ROOT/.github/workflows/release-image.yml" ||
  fail "image Releases are not built on the native Ubuntu 24.04 ARM runner"
grep -Fq 'omarchy-aarch64-ezvm.raw.sha256' "$ROOT/.github/workflows/release-image.yml" &&
  grep -Fq 'package-ezvm-release' "$ROOT/.github/workflows/release-image.yml" ||
  fail "the release workflow does not build and package the EZVM raw image"
if grep -Fq 'actions/upload-artifact' "$ROOT/.github/workflows/release-image.yml"; then
  fail "the multi-gigabyte image is copied through Actions artifact storage"
fi
grep -Fq 'uses: actions/cache/save@v6' "$ROOT/.github/workflows/release-image.yml" ||
  fail "verified rolling inputs are only cached after the entire Release succeeds"
grep -Fq -- '--notes-file RELEASE_NOTES.md' "$ROOT/.github/workflows/release-image.yml" &&
  grep -Fq 'releases/latest/download/install-Omarchy-ezvm.command' "$ROOT/RELEASE_NOTES.md" &&
  grep -Fq 'releases/latest/download/install-Omarchy-ezvm.command' "$ROOT/README.md" ||
  fail "GitHub Releases do not expose the one-command latest installer"
pass "native GitHub image publishing emits only the verified EZVM image path"
grep -Fq 'pacman failed after 8 attempts' "$ROOT/bin/build-image" ||
  fail "target package installation does not tolerate transient mirror failures"
grep -Fq -- '--dearmor --output "$partial" "$ROOTFS_KEYRING"' "$ROOT/bin/build-image" ||
  fail "ASCII-armored Arch Linux ARM keys are not normalized for gpgv"
grep -Fq -- '--keyring "$ROOTFS_VERIFY_KEYRING"' "$ROOT/bin/build-image" ||
  fail "rootfs verification does not use the normalized keyring"
if grep -Fq 'linux-firmware' "$ROOT/bin/build-image"; then
  fail "generic image builder contains a profile-specific firmware exception"
fi
pass "profile package rules remove firmware without generic-builder exceptions"

if grep -Fq 'source=/dev,target=/dev' "$ROOT/bin/build-image-container"; then
  fail "the privileged image container exposes the host /dev tree as a writable bind mount"
fi
grep -Fq 'ensure_loop_device_nodes' "$ROOT/bin/build-image" ||
  fail "the isolated image container cannot restore missing base loop nodes"
if sed -n '/^cleanup()/,/^}/p' "$ROOT/bin/build-image" | grep -Fq 'rm -rf'; then
  fail "failed image cleanup recursively deletes mount-tree paths"
fi
grep -Fq 'path_has_mounts "$side"' "$ROOT/bin/build-image" ||
  fail "failed image cleanup does not guard retained mount trees"
grep -Fq 'gpgconf --homedir /etc/pacman.d/gnupg --kill all' "$ROOT/bin/build-image" ||
  fail "image assembly does not stop the pacman keyring agent before unmounting"
grep -Fq 'process_root == "$MOUNT_DIR"' "$ROOT/bin/build-image" ||
  fail "target helper cleanup is not scoped to the disposable image root"
grep -Fq 'managed-packages' "$ROOT/bin/build-image" ||
  fail "the image does not record packages managed by the Omarchy repository"
grep -Fq 'validate_omarchy_repository_manifest' "$ROOT/bin/build-image" ||
  fail "the image can combine a repository snapshot with a different Omarchy source commit"
grep -Fq 'etc/omarchy-aarch64/excluded-packages' "$ROOT/bin/build-image" ||
  fail "the image does not preserve profile exclusions for reinstall workflows"
grep -Fq 'cp -a --no-preserve=ownership "$OVERLAY_DIR/." "$MOUNT_DIR/"' \
  "$ROOT/bin/build-image" ||
  fail "the profile overlay can leak the builder UID/GID into the target rootfs"
grep -Fq -- '--omarchy-repository /omarchy-repository' "$ROOT/bin/build-image-container" ||
  fail "the container wrapper cannot expose a local signed repository to the builder"
grep -Fq 'mount -o remount,bind,ro "$MOUNT_DIR/run/omarchy-aarch64-repository"' \
  "$ROOT/bin/build-image" ||
  fail "the local development repository is writable inside the image chroot"
grep -Fq 'root_owned_paths=(' "$ROOT/bin/build-image" ||
  fail "image validation does not enforce trusted rootfs directory ownership"
grep -Fq 'virtiofs?' "$ROOT/bin/build-image" ||
  fail "image build does not keep virtiofs available for the EZVM enrollment share"
grep -Fq 'uinput?' "$ROOT/bin/build-image" ||
  fail "image build does not keep uinput available for early guest input"

display_watch="$ROOT/profiles/aarch64-virt/overlay/usr/local/libexec/omarchy-ezvm-display-watch"
display_setup="$ROOT/profiles/aarch64-virt/overlay/usr/local/libexec/omarchy-ezvm-display-setup"
monitor_wrapper="$ROOT/profiles/aarch64-virt/overlay/usr/local/bin/omarchy-hyprland-monitor-watch"
session_monitor_wrapper="$ROOT/profiles/aarch64-virt/overlay/usr/bin/omarchy-hyprland-monitor-watch"
display_watch_unit="$ROOT/profiles/aarch64-virt/overlay/etc/systemd/user/omarchy-ezvm-display-watch.service"
display_setup_unit="$ROOT/profiles/aarch64-virt/overlay/etc/systemd/user/omarchy-ezvm-display-setup.service"
display_watch_dropin="$ROOT/profiles/aarch64-virt/overlay/etc/systemd/user/spice-display-bridge.service.d/90-ezvm-virtio-display.conf"
display_setup_dropin="$ROOT/profiles/aarch64-virt/overlay/etc/systemd/user/spice-guest-tools-bootstrap.service.d/90-ezvm-display-owner.conf"
spice_config="$ROOT/profiles/aarch64-virt/overlay/usr/share/spice-guest-tools/config/config.toml"
sddm_hyprland="$ROOT/profiles/aarch64-virt/overlay/usr/share/sddm/hyprland.lua"
[[ -x $display_watch && -x $display_setup && -x $monitor_wrapper && -x $session_monitor_wrapper ]] ||
  fail "EZVM Hyprland display integration is not executable"
grep -Fq 'ExecStart=/usr/local/libexec/omarchy-ezvm-display-watch' "$display_watch_unit" ||
  fail "EZVM does not ship an independent virtio-gpu display watcher unit"
grep -Fq 'Requires=omarchy-ezvm-display-setup.service' "$display_watch_unit" ||
  fail "EZVM display watcher does not require display ownership setup"
! grep -Eq 'Condition(PathExists|Environment)=' "$display_watch_unit" ||
  fail "EZVM display watcher must not inherit SPICE or imported-environment conditions"
grep -Fq 'ExecStart=/usr/local/libexec/omarchy-ezvm-display-setup' "$display_setup_unit" ||
  fail "EZVM does not ship an independent display ownership setup unit"
grep -Fq 'ExecStart=/usr/local/libexec/omarchy-ezvm-display-watch' "$display_watch_dropin" ||
  fail "EZVM does not replace the enabled SPICE display bridge with its virtio-gpu watcher"
grep -Fq 'ExecStart=/usr/local/libexec/omarchy-ezvm-display-setup' "$display_setup_dropin" ||
  fail "EZVM does not replace SPICE bootstrap with its display ownership migration"
grep -Fq 'remove_spice_monitor_ownership' "$display_setup" ||
  fail "EZVM display migration does not remove stale SPICE monitor ownership"
awk '
  /^\[display\]$/ { section = "display"; next }
  /^\[clipboard\]$/ { section = "clipboard"; next }
  /^\[/ { section = "" }
  section == "display" && $0 == "enabled = false" { display_disabled = 1 }
  section == "clipboard" && $0 == "enabled = true" { clipboard_enabled = 1 }
  END { exit !(display_disabled && clipboard_enabled) }
' "$spice_config" || fail "EZVM must disable SPICE display while preserving clipboard"
grep -Fq 'virtio_gpu' "$display_watch" ||
  fail "EZVM display watcher is not restricted to virtio-gpu"
grep -Fq '"$DRM_ROOT"/card*-*' "$display_watch" ||
  fail "EZVM display watcher does not observe DRM mode changes"
grep -Fq 'hyprctl reload' "$display_watch" ||
  fail "EZVM display watcher does not re-evaluate preferred modes"
grep -Fq 'hl.monitor({' "$display_watch" ||
  fail "EZVM display watcher does not reconcile Hyprland with the DRM preferred mode"
grep -Fq '/usr/local/libexec/omarchy-hyprland-monitor-watch-upstream' "$session_monitor_wrapper" ||
  fail "EZVM session monitor wrapper does not retain Omarchy monitor recovery"
grep -Fq '/usr/local/libexec/omarchy-ezvm-display-setup' "$session_monitor_wrapper" ||
  fail "EZVM monitor wrapper does not migrate existing SPICE display ownership"
grep -Fq '/usr/bin/omarchy-hyprland-monitor-watch' "$monitor_wrapper" ||
  fail "EZVM compatibility monitor wrapper does not delegate to the session entry point"
grep -Fq '/usr/local/libexec/omarchy-ezvm-display-watch' "$sddm_hyprland" ||
  fail "EZVM SDDM greeter does not start dynamic virtio-gpu display reconciliation"
grep -Fq 'mode = "preferred"' "$sddm_hyprland" ||
  fail "EZVM SDDM greeter does not select the host-provided preferred mode"

(
  fixture=$(mktemp -d)
  watcher_pid=
  trap '[[ -z $watcher_pid ]] || kill "$watcher_pid" 2>/dev/null || true; rm -rf "$fixture"' EXIT
  mkdir -p "$fixture/drm/card0/device" "$fixture/drivers/virtio_gpu" "$fixture/drm/card0-Virtual-1"
  ln -s "$fixture/drivers/virtio_gpu" "$fixture/drm/card0/device/driver"
  printf 'connected\n' >"$fixture/drm/card0-Virtual-1/status"
  printf '1920x1080\n' >"$fixture/drm/card0-Virtual-1/modes"
  printf '#!/bin/bash\nprintf "%%s\\n" "$*" >>"$OMARCHY_EZVM_HYPRCTL_LOG"\n' >"$fixture/hyprctl"
  chmod 755 "$fixture/hyprctl"

  OMARCHY_EZVM_DRM_ROOT="$fixture/drm" \
    OMARCHY_EZVM_HYPRCTL="$fixture/hyprctl" \
    OMARCHY_EZVM_HYPRCTL_LOG="$fixture/hyprctl.log" \
    OMARCHY_EZVM_LOG="$fixture/display-watch.log" \
    OMARCHY_EZVM_POLL_INTERVAL=0.05 \
    XDG_RUNTIME_DIR="$fixture" \
    "$display_watch" &
  watcher_pid=$!
  sleep 0.1
  : >"$fixture/hyprctl.log"
  printf '2560x1440\n1920x1080\n' >"$fixture/drm/card0-Virtual-1/modes"
  for _ in {1..40}; do
    if grep -Fxq reload "$fixture/hyprctl.log" 2>/dev/null &&
      grep -Fxq 'eval hl.monitor({ output = "Virtual-1", mode = "2560x1440", position = "auto", scale = "auto" })' "$fixture/hyprctl.log" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  [[ -s $fixture/hyprctl.log ]] || fail "EZVM display watcher did not react to a mode-list change"
  grep -Fxq reload "$fixture/hyprctl.log" ||
    fail "EZVM display watcher did not ask Hyprland to reload preferred mode"
  grep -Fxq 'eval hl.monitor({ output = "Virtual-1", mode = "2560x1440", position = "auto", scale = "auto" })' "$fixture/hyprctl.log" ||
    { sed -n '1,120p' "$fixture/hyprctl.log" >&2
      fail "EZVM display watcher did not apply the new DRM preferred mode to Hyprland"; }
  kill "$watcher_pid" 2>/dev/null || true
  wait "$watcher_pid" 2>/dev/null || true
  watcher_pid=

  rm "$fixture/drm/card0/device/driver"
  mkdir -p "$fixture/drivers/virtio-pci" "$fixture/modules/virtio_gpu"
  ln -s "$fixture/drivers/virtio-pci" "$fixture/drm/card0/device/driver"
  ln -s "$fixture/modules/virtio_gpu" "$fixture/drivers/virtio-pci/module"
  : >"$fixture/hyprctl.log"
  OMARCHY_EZVM_DRM_ROOT="$fixture/drm" \
    OMARCHY_EZVM_HYPRCTL="$fixture/hyprctl" \
    OMARCHY_EZVM_HYPRCTL_LOG="$fixture/hyprctl.log" \
    OMARCHY_EZVM_LOG="$fixture/display-watch.log" \
    OMARCHY_EZVM_POLL_INTERVAL=0.05 \
    XDG_RUNTIME_DIR="$fixture" \
    "$display_watch" &
  watcher_pid=$!
  for _ in {1..20}; do
    [[ -s $fixture/hyprctl.log ]] && break
    sleep 0.05
  done
  [[ -s $fixture/hyprctl.log ]] ||
    fail "EZVM display watcher rejected a virtio-pci device backed by virtio_gpu"
  kill "$watcher_pid" 2>/dev/null || true
  wait "$watcher_pid" 2>/dev/null || true
  watcher_pid=
)
pass "EZVM display watcher reacts to virtio-gpu mode changes"

(
  fixture=$(mktemp -d)
  trap 'rm -rf "$fixture"' EXIT
  mkdir -p "$fixture/home/.config/hypr" "$fixture/home/.config/spice-guest-tools" \
    "$fixture/home/.local/state/spice-guest-tools" "$fixture/bin"
  cat >"$fixture/home/.config/hypr/monitors.lua" <<'EOF'
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })

-- BEGIN spice-guest-tools managed mode
hl.monitor({ output = "Virtual-1", mode = "modeline stale", position = "0x0", scale = 2 })
-- END spice-guest-tools managed mode
EOF
  cat >"$fixture/home/.config/spice-guest-tools/config.toml" <<'EOF'
[display]
enabled = true
output = "auto"

[clipboard]
enabled = true
EOF
  : >"$fixture/home/.local/state/spice-guest-tools/display.state"
  printf '#!/bin/bash\nexit 0\n' >"$fixture/bin/systemctl"
  printf '#!/bin/bash\nexit 0\n' >"$fixture/bin/hyprctl"
  chmod 755 "$fixture/bin/systemctl" "$fixture/bin/hyprctl"
  HOME="$fixture/home" PATH="$fixture/bin:$PATH" "$display_setup"
  ! grep -Fq 'spice-guest-tools managed mode' "$fixture/home/.config/hypr/monitors.lua" ||
    fail "EZVM display migration left SPICE monitor ownership behind"
  grep -Fq 'mode = "preferred"' "$fixture/home/.config/hypr/monitors.lua" ||
    fail "EZVM display migration damaged the Omarchy preferred monitor rule"
  awk '
    /^\[display\]$/ { section = "display"; next }
    /^\[/ { section = "" }
    section == "display" && $0 == "enabled = false" { found = 1 }
    END { exit !found }
  ' "$fixture/home/.config/spice-guest-tools/config.toml" ||
    fail "EZVM display migration did not disable the SPICE display bridge"
  [[ ! -e $fixture/home/.local/state/spice-guest-tools/display.state ]] ||
    fail "EZVM display migration retained a stale SPICE modeline"
)
pass "EZVM display migration preserves clipboard while removing SPICE mode ownership"
