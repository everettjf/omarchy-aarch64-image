[Unit]
Description=RiftVM Omarchy desktop session integration
After=graphical-session.target spice-guest-tools-bootstrap.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/rift-agent --session
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/rift-agent/sessions /mnt/riftvm-shared
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
