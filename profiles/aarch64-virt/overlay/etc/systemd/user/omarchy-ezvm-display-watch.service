[Unit]
Description=Watch EZVM virtio-gpu display modes
Requires=omarchy-ezvm-display-setup.service
After=graphical-session.target omarchy-ezvm-display-setup.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
ExecStart=/usr/local/libexec/omarchy-ezvm-display-watch
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
