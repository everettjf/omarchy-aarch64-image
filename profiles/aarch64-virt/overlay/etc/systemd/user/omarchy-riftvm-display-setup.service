[Unit]
Description=Initialize RiftVM virtio-gpu display ownership
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
ExecStart=/usr/local/libexec/omarchy-riftvm-display-setup
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
