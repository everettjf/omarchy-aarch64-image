#!/bin/bash

set -euo pipefail

raw_mount=${HOSTSHARE_RAW_MOUNT:-/mnt/hostshare}
state_file=${HOSTSHARE_STATE_FILE:-/run/omarchy-aarch64/hostshare-target}
sddm_state=${HOSTSHARE_SDDM_STATE:-/var/lib/sddm/state.conf}
autologin_config=${HOSTSHARE_AUTOLOGIN_CONFIG:-/etc/sddm.conf.d/autologin.conf}
login_defs=${HOSTSHARE_LOGIN_DEFS:-/etc/login.defs}

log() {
  printf 'omarchy-aarch64-hostshare: %s\n' "$*"
}

uid_limit() {
  local field=$1 fallback=$2 value
  value=$(awk -v field="$field" '$1 == field { print $2; exit }' "$login_defs" 2>/dev/null || true)
  [[ $value =~ ^[0-9]+$ ]] || value=$fallback
  printf '%s\n' "$value"
}

valid_owner_record() {
  local candidate=$1 record user password uid gid gecos home shell uid_min uid_max

  [[ -n $candidate ]] || return 1
  record=$(getent passwd "$candidate" 2>/dev/null || true)
  [[ -n $record ]] || return 1
  IFS=: read -r user password uid gid gecos home shell <<<"$record"
  uid_min=$(uid_limit UID_MIN 1000)
  uid_max=$(uid_limit UID_MAX 60000)

  [[ $user == "$candidate" && $uid =~ ^[0-9]+$ && $gid =~ ^[0-9]+$ ]] || return 1
  ((uid >= uid_min && uid <= uid_max)) || return 1
  [[ $home == /home/* && -d $home ]] || return 1
  [[ $shell != */nologin && $shell != */false ]] || return 1
  printf '%s\n' "$record"
}

find_owner_record() {
  local candidate record user password uid gid gecos home shell uid_min uid_max
  local -A seen=()
  local -a candidates=()

  if [[ -f $sddm_state ]]; then
    candidate=$(sed -n 's/^User=//p' "$sddm_state" | tail -n1)
    [[ -n $candidate ]] && candidates+=("$candidate")
  fi
  if [[ -f $autologin_config ]]; then
    candidate=$(sed -n 's/^User=//p' "$autologin_config" | tail -n1)
    [[ -n $candidate ]] && candidates+=("$candidate")
  fi

  for candidate in "${candidates[@]}"; do
    [[ -z ${seen[$candidate]:-} ]] || continue
    seen[$candidate]=1
    if record=$(valid_owner_record "$candidate"); then
      printf '%s\n' "$record"
      return 0
    fi
  done

  uid_min=$(uid_limit UID_MIN 1000)
  uid_max=$(uid_limit UID_MAX 60000)
  while IFS=: read -r user password uid gid gecos home shell; do
    [[ $uid =~ ^[0-9]+$ && $gid =~ ^[0-9]+$ ]] || continue
    ((uid >= uid_min && uid <= uid_max)) || continue
    [[ $home == /home/* && -d $home ]] || continue
    [[ $shell != */nologin && $shell != */false ]] || continue
    printf '%s:%s:%s:%s:%s:%s:%s\n' "$user" "$password" "$uid" "$gid" "$gecos" "$home" "$shell"
    return 0
  done < <(getent passwd)

  return 1
}

build_mapping() {
  local source_uid=$1 source_gid=$2 guest_uid=$3 guest_gid=$4 mapping=""

  [[ $source_uid == "$guest_uid" ]] || mapping="$source_uid/$guest_uid"
  if [[ $source_gid != "$guest_gid" ]]; then
    mapping+="${mapping:+:}@$source_gid/@$guest_gid"
  fi
  printf '%s\n' "$mapping"
}

unmount_hostshare() {
  local target
  [[ -f $state_file ]] || return 0
  target=$(<"$state_file")
  case $target in
    /home/*/Hostshare) ;;
    *) log "refusing unexpected recorded mount point: $target"; return 1 ;;
  esac
  mountpoint -q "$target" && umount -- "$target"
  rm -f -- "$state_file"
}

mount_hostshare() {
  local record user password uid gid gecos home shell target
  local source_uid source_gid mapping

  if [[ $(findmnt -rn -M "$raw_mount" -o FSTYPE 2>/dev/null || true) != 9p ]]; then
    log "no 9p host share is mounted at $raw_mount; skipping"
    return 0
  fi
  if ! record=$(find_owner_record); then
    log "no provisioned desktop owner was found; skipping"
    return 0
  fi
  IFS=: read -r user password uid gid gecos home shell <<<"$record"
  target="$home/Hostshare"

  if [[ -L $target ]]; then
    log "refusing symbolic-link mount point: $target"
    return 1
  fi
  if [[ -e $target && ! -d $target ]]; then
    log "refusing non-directory mount point: $target"
    return 1
  fi
  if mountpoint -q "$target"; then
    log "$target is already mounted"
    return 0
  fi

  install -d -m700 -o "$uid" -g "$gid" "$target"
  if [[ -n $(find "$target" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
    log "refusing to hide the non-empty directory $target"
    return 1
  fi

  read -r source_uid source_gid < <(stat -c '%u %g' "$raw_mount")
  [[ $source_uid =~ ^[0-9]+$ && $source_gid =~ ^[0-9]+$ ]] || {
    log "could not determine host UID/GID at $raw_mount"
    return 1
  }
  mapping=$(build_mapping "$source_uid" "$source_gid" "$uid" "$gid")

  if [[ -n $mapping ]]; then
    bindfs --map="$mapping" "$raw_mount" "$target"
    log "mapped host IDs $source_uid:$source_gid to $user ($uid:$gid) at $target"
  else
    mount --bind "$raw_mount" "$target"
    log "host and guest IDs already match; mounted $target"
  fi

  install -d -m755 "${state_file%/*}"
  printf '%s\n' "$target" >"$state_file"
  chmod 600 "$state_file"
}

main() {
  case ${1:-} in
    "") mount_hostshare ;;
    --unmount) unmount_hostshare ;;
    *) echo "Usage: ${0##*/} [--unmount]" >&2; exit 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
