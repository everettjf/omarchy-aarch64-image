#!/bin/bash

# UWSM resolves Omarchy's monitor watcher from /usr/bin in this image. Start
# EZVM's virtio-gpu display owner beside the preserved upstream recovery loop.

set -u

/usr/local/libexec/omarchy-ezvm-display-setup
/usr/local/libexec/omarchy-ezvm-display-watch &
display_watch_pid=$!

cleanup() {
  kill "$display_watch_pid" 2>/dev/null || true
  wait "$display_watch_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

/usr/local/libexec/omarchy-hyprland-monitor-watch-upstream
