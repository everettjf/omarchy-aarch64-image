#!/bin/bash

# virtio-gpu reports a host resize as a changed mode list on the existing DRM
# connector. Hyprland's normal monitor event stream does not emit monitoradded
# or monitorremoved for that case, so re-evaluate Omarchy's existing
# `mode = "preferred"` configuration whenever the list changes.

set -u

readonly INSTANCE_LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-ezvm-display-watch.instance.lock"
readonly DRM_ROOT="${OMARCHY_EZVM_DRM_ROOT:-/sys/class/drm}"
readonly HYPRCTL="${OMARCHY_EZVM_HYPRCTL:-hyprctl}"
readonly POLL_INTERVAL="${OMARCHY_EZVM_POLL_INTERVAL:-1}"
readonly LOG_FILE="${OMARCHY_EZVM_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-ezvm-display-watch.log}"

log_debug() {
  # Keep the volatile per-session file for quick local inspection, but also
  # write to stdout so the user service records the same evidence in the
  # persistent journal.  Display failures otherwise disappear at shutdown,
  # precisely when an offline image inspection is most useful.
  local line
  printf -v line '%(%FT%T%z)T %s' -1 "$*"
  printf '%s\n' "$line" | tee -a "$LOG_FILE"
}

discover_hyprland_instance() {
  local socket instance_dir
  [[ -n ${OMARCHY_EZVM_HYPRCTL:-} ]] && return 0
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && return 0
  for socket in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/hypr/*/.socket.sock; do
    [[ -S $socket ]] || continue
    instance_dir=${socket%/.socket.sock}
    export HYPRLAND_INSTANCE_SIGNATURE=${instance_dir##*/}
    log_debug "discovered Hyprland instance $HYPRLAND_INSTANCE_SIGNATURE"
    return 0
  done
  return 1
}

uses_virtio_gpu() {
  local device driver module
  # On a real virtio-pci device the DRM card's immediate driver link may name
  # virtio-pci, while its module link identifies the actual DRM implementation.
  # Accept either representation. The module directory is also a reliable
  # fallback when sysfs does not expose a per-device module link.
  [[ $DRM_ROOT == /sys/class/drm && -d /sys/module/virtio_gpu ]] && return 0
  for device in "$DRM_ROOT"/card*/device; do
    [[ -e $device ]] || continue
    driver=$(readlink -f "$device/driver" 2>/dev/null || true)
    [[ ${driver##*/} == virtio_gpu ]] && return 0
    module=$(readlink -f "$device/driver/module" 2>/dev/null || true)
    [[ ${module##*/} == virtio_gpu ]] && return 0
  done
  return 1
}

mode_signature() {
  local connector line signature=""
  for connector in "$DRM_ROOT"/card*-*; do
    [[ -f $connector/status ]] || continue
    signature+="${connector##*/}:"
    while IFS= read -r line; do signature+="$line,"; done <"$connector/status"
    if [[ -f $connector/modes ]]; then
      while IFS= read -r line; do signature+="$line,"; done <"$connector/modes"
    fi
    signature+=';'
  done
  printf '%s\n' "$signature"
}

reconcile_current_mode() {
  local connector connector_name preferred current
  discover_hyprland_instance || return 0
  for connector in "$DRM_ROOT"/card*-*; do
    [[ -f $connector/status && $(<"$connector/status") == connected ]] || continue
    [[ -s $connector/modes ]] || continue
    connector_name=${connector##*/}
    connector_name=${connector_name#card*-}
    preferred=$(head -n 1 "$connector/modes")
    [[ $preferred =~ ^[0-9]+x[0-9]+$ ]] || continue
    [[ $connector_name =~ ^[A-Za-z0-9._-]+$ ]] || continue
    current=$("$HYPRCTL" -j monitors all 2>/dev/null | jq -r --arg name "$connector_name" \
      '.[] | select(.name == $name) | "\(.width)x\(.height)"' 2>/dev/null | head -n 1)
    [[ $current == "$preferred" ]] && continue

    # Reloading a `preferred` monitor rule is not sufficient on every Hyprland
    # release: after a virtio-gpu hotplug it can retain the old current mode
    # even though the new preferred mode is already first in DRM sysfs. Apply
    # that exact mode at runtime, while leaving the user's persisted config
    # untouched. The next poll verifies that the compositor accepted it.
    # Current Omarchy uses Hyprland's Lua configuration parser. `keyword`
    # prints a rejection while still exiting zero there, so use the same
    # `hyprctl eval` API as Omarchy's own monitor helpers.
    if output=$("$HYPRCTL" eval \
      "hl.monitor({ output = \"$connector_name\", mode = \"$preferred\", position = \"auto\", scale = \"auto\" })" 2>&1); then
      log_debug "requested $connector_name mode $preferred (was ${current:-unknown}): $output"
    else
      log_debug "failed to apply $connector_name mode $preferred (was ${current:-unknown}): $output"
    fi
  done
}

install -d -m 0700 "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"
log_debug "watcher starting: drm_root=$DRM_ROOT"
exec 8>"$INSTANCE_LOCK"
if ! flock -n 8; then
  log_debug "another display watcher already owns $INSTANCE_LOCK; exiting"
  exit 0
fi
if ! uses_virtio_gpu; then
  log_debug "no virtio_gpu DRM device found; watcher exiting"
  exit 0
fi
log_debug "virtio_gpu DRM device detected"

# A host resize may have completed before this user-session helper starts.
# Reconcile the exact DRM preferred mode directly. Repeated `hyprctl reload`
# calls race with this setting on current Omarchy: each reload can restore the
# compositor's cached old `preferred` mode, causing old/new scanouts to flap
# until Hyprland eventually leaves the new output black.
reconcile_current_mode
previous=$(mode_signature)
log_debug "initial DRM signature: $previous"
while sleep "$POLL_INTERVAL"; do
  current=$(mode_signature)
  if [[ $current != "$previous" ]]; then
    log_debug "DRM signature changed: $current"
    previous=$current
    # Give virtio-gpu's connector and mode list a short interval to settle,
    # then apply the final preferred mode once. The normal reconciliation below
    # retries only if Hyprland did not accept it.
    sleep 0.2
  fi
  reconcile_current_mode
done
