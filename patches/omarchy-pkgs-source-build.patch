diff --git i/bin/build w/bin/build
index 62cc623..1297d2b 100755
--- i/bin/build
+++ w/bin/build
@@ -150,6 +150,13 @@ DOCKER_ARGS=(
   -v "$BUILD_ROOT/pkgbuilds:/pkgbuilds:ro"
 )
 
+if [[ -n ${OMARCHY_SRC:-} ]]; then
+  DOCKER_ARGS+=(
+    -e OMARCHY_SRC=/omarchy-src
+    -v "$OMARCHY_SRC:/omarchy-src:ro"
+  )
+fi
+
 # Run the builder with assembled args
 IMAGE_TAG="omarchy-pkg-builder:latest-$ARCH-$MIRROR"
 PLATFORM_ARG=$(get_platform_arg "$ARCH")
